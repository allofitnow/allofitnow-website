---
import '@/styles/tokens.css';
import '@/styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/chrome/Nav.astro';
import Cursor from '@/components/chrome/Cursor.astro';
import HoverCard from '@/components/chrome/HoverCard.astro';
import FootBar from '@/components/chrome/FootBar.astro';
import InquiryModal from '@/components/chrome/InquiryModal.astro';
import Preloader from '@/components/home/Preloader.astro';
import { getProjects } from '@/data/projects';

interface Props {
  title?: string;
  description?: string;
  /** Render the branded preloader as an instant black cover on a FULL document
   *  load (direct visit / refresh). It's hidden on every ClientRouter soft-nav
   *  so it never covers the flight morph. The homepage opts out — it drives its
   *  own preloader (with the intro lockup) from home.controller. */
  preloader?: boolean;
}

const {
  title = 'All Of It Now',
  description = 'All Of It Now — a real-time content and show production studio in Los Angeles.',
  preloader = false,
} = Astro.props;

// The flight engine needs the ordered project roster (for the morph sequence),
// but it runs client-side and can't await — so we bake the order into a data
// attribute on the persistent flight layer at build time.
const projects = await getProjects();
const flightOrder = JSON.stringify(projects.map((p) => p.slug));

// #67: canonical origin from astro.config `site` (SITE_URL env at build time).
const SITE_URL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://46009.someofitlater.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* #60 Save-Data: MUST be inline + blocking + ahead of every img so the
        rewrite is in place before the preload scanner reaches the body.
        A deferred script loses the race on the eager hero. No-op unless
        navigator.connection.saveData is true (Chromium opt-in). */}
    <script is:inline>
      (function () {
        var c = navigator.connection;
        var light = c.saveData || /^(slow-)?2g$/.test(c.effectiveType || '');
        if (!light) return;
        if (c.saveData) document.documentElement.setAttribute('data-save-data', '1');
        function capAttrs(img) {
          var pairs = [['srcset', 'src'], ['data-lazysrcset', 'data-lazysrc']];
          for (var p = 0; p < pairs.length; p++) {
            var ssA = pairs[p][0], srcA = pairs[p][1];
            var ss = img.getAttribute(ssA);
            if (!ss || ss.indexOf('w') === -1) continue;
            var hero = img.getAttribute('fetchpriority') === 'high';
            var maxW = hero ? 600 : 400, keep = [], best = null;
            ss.split(',').forEach(function (part) {
              var seg = part.trim().match(/^(\S+)\s+(\d+)w$/);
              if (!seg) return;
              var w = +seg[2];
              if (w <= maxW) keep.push(seg[0]);
              if (!best || w < best.w) best = { w: w, u: seg[1] };
            });
            if (!keep.length && best) keep = [best.u + ' ' + best.w + 'w'];
            if (keep.length) {
              img.setAttribute(ssA, keep.join(', '));
              var s = img.getAttribute(srcA);
              if (s && /-\d+x\d+\./.test(s)) img.setAttribute(srcA, keep[keep.length - 1].split(' ')[0]);
            }
          }
        }
        function walk(n) {
          if (n.nodeType !== 1) return;
          if (n.tagName === 'IMG') capAttrs(n);
          else if (n.querySelectorAll) {
            var l = n.querySelectorAll('img');
            for (var i = 0; i < l.length; i++) capAttrs(l[i]);
          }
        }
        var cur = document.getElementsByTagName('img');
        for (var i = 0; i < cur.length; i++) capAttrs(cur[i]);
        new MutationObserver(function (muts) {
          for (var m = 0; m < muts.length; m++) {
            var add = muts[m].addedNodes;
            for (var k = 0; k < add.length; k++) walk(add[k]);
          }
        }).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* #67 OG/Twitter meta: crawlers don't run JS, so this must live in the
        served HTML. SITE_URL (astro.config site) selects the serving origin;
        og:image is the pinned raster card generated from the brand wordmark. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="All Of It Now" />
    <meta property="og:image" content={`${SITE_URL}/assets/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${SITE_URL}${Astro.url.pathname}`} />
    <link rel="canonical" href={`${SITE_URL}${Astro.url.pathname}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/assets/og-image.png`} />
    {/* The browser asks for /favicon.ico on its own, whatever is declared here,
        and it caches the answer hard. So the real mark has to live AT that path
        rather than only being pointed to from one: what shipped before was the
        Astro starter's logo sitting at /favicon.ico and /favicon.svg, which is
        what the tab actually showed. Declaring the .ico as well keeps the two
        in step. The SVG is listed second and wins wherever it is understood. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Fonts are on the critical path — the preloader/intro is gated on
        document.fonts.ready, so avoid the FOIT that font-display:block causes. */}
    <link rel="preload" href="/fonts/DenimINKWD-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DenimINKWD-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SNJaMono-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/OOTheran-Light.woff2" as="font" type="font/woff2" crossorigin />

    {/* SPA soft-nav powers the flight. Work-bound links — grid tiles, the hero
        back, the nav/footer WORK, the About cue — soft-nav so the flyer runs.
        Everything else (logo, hash links, the #about deep-link) carries
        data-astro-reload and full-loads, and the home controller tears itself
        down on astro:before-swap, so it never has to survive a swap. */}
    <ClientRouter />
  </head>
  <body>
    {/* Instant black cover on a full document load — its render-blocking CSS
        paints black on the first frame, so page content never flashes before
        its intro. Hidden on any soft-nav (see the script) so the flight is
        never covered. */}
    {preloader && (
      <div data-base-preloader>
        <Preloader />
      </div>
    )}
    {/* Nav + Cursor persist across soft swaps (transition:persist is on their
        own root elements) so their once-bound scripts — clock, reveal, crosshair
        — keep working instead of re-binding to fresh nodes each navigation. */}
    <Nav />
    <slot />
    <Cursor />
    <HoverCard />
    {/* Site-wide thin foot bar (tagline + socials). On the homepage the controller
        owns its scroll-reactive reveal; interior pages self-reveal (see FootBar). */}
    <FootBar />

    {/* Site-wide contact modal. Persisted across soft-navs so its one <dialog>
        (and its bound listeners) survive; opened by any [data-inquiry-open]
        trigger (nav/footer CONTACT, project bar, services CTA) via delegation. */}
    <InquiryModal transition:persist="aoin-inquiry" />

    {/* The flyer travels in here; transition:persist keeps the layer (and the
        in-flight artwork) alive across the ClientRouter DOM swap. */}
    <div
      id="aoin-flight-layer"
      transition:persist="aoin-flight-layer"
      aria-hidden="true"
      data-flight-order={flightOrder}
    ></div>

    <script>
      import '@/lib/flight';
      import '@/lib/hovercard';
      import { ensureLenis } from '@/lib/smooth-scroll';

      // Site-wide smooth scroll: ensure the shared Lenis exists and is measured on each page,
      // and sync its position to the top after a ClientRouter swap (Astro resets native scroll,
      // but Lenis keeps its own). The homepage controller and /services reuse the same instance.
      const bootScroll = () => { const l = ensureLenis(); if (l) l.resize(); };
      document.addEventListener('astro:page-load', bootScroll);
      document.addEventListener('astro:after-swap', () => {
        const l = ensureLenis();
        if (l) l.scrollTo(0, { immediate: true });
        // Any swap is a soft-nav — hide the preloader instantly (this runs
        // pre-paint) so it can never cover a flight morph into a project.
        const p = document.querySelector('[data-base-preloader] [data-ref="preloader"]');
        if (p) { p.style.display = 'none'; p.dataset.done = '1'; }
      });

      // Branded preloader — runs its 0->100 count only on a full document load
      // (this module executes once per load, not on soft-navs). The `[data-base-
      // preloader]` scope keeps it clear of the homepage's own preloader.
      const scope = document.querySelector('[data-base-preloader]');
      const pre = scope && scope.querySelector<HTMLElement>('[data-ref="preloader"]');
      if (pre && !pre.dataset.done) {
        pre.dataset.done = '1';
        const count = scope!.querySelector<HTMLElement>('[data-ref="preCount"]');
        const label = scope!.querySelector<HTMLElement>('[data-ref="preLabel"]');
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Linked from /services (which already played its own staggered exit) — skip the 0->100 count
        // beat but keep the black flash-cover, lifting straight away. One-shot flag, cleared on read.
        const fromServices = (() => {
          try { const v = sessionStorage.getItem('aoin-from-services'); if (v) sessionStorage.removeItem('aoin-from-services'); return !!v; } catch (_) { return false; }
        })();
        const lift = () => {
          [label, count].filter(Boolean).forEach((el, i) =>
            el!.animate(
              [{ transform: 'translateY(0%)' }, { transform: 'translateY(-115%)' }],
              { duration: 440, delay: 20 + i * 60, easing: 'cubic-bezier(.05,.89,0,.99)', fill: 'both' },
            ),
          );
          setTimeout(() => { pre.style.background = 'transparent'; }, 200);
          setTimeout(() => { pre.style.display = 'none'; }, 560);
        };
        if (reduced) {
          pre.style.display = 'none';
        } else if (fromServices) {
          lift(); // skip the count, keep the cover, lift immediately
        } else {
          const dur = 1100;
          const t0 = performance.now();
          const ease = (t: number) => 1 - Math.pow(1 - t, 3);
          const step = (now: number) => {
            const t = Math.min(1, (now - t0) / dur);
            if (count) count.textContent = String(Math.round(ease(t) * 100));
            if (t < 1) requestAnimationFrame(step);
            else lift();
          };
          requestAnimationFrame(step);
        }
      }
    </script>
  </body>
</html>
