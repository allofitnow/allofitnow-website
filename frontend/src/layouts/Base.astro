---
import '@/styles/tokens.css';
import '@/styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '@/components/chrome/Nav.astro';
import Cursor from '@/components/chrome/Cursor.astro';
import HoverCard from '@/components/chrome/HoverCard.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'All Of It Now',
  description = 'All Of It Now — a real-time content and show production studio in Los Angeles.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/aoin-icon.svg" type="image/svg+xml" />

    {/* Fonts are on the critical path — the preloader/intro is gated on
        document.fonts.ready, so avoid the FOIT that font-display:block causes. */}
    <link rel="preload" href="/fonts/DenimINKWD-Medium.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/DenimINKWD-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/SNJaMono-Light.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/OOTheran-Light.otf" as="font" type="font/otf" crossorigin />

    {/* SPA soft-nav powers the flight. Work-bound links — grid tiles, the hero
        back, the nav/footer WORK, the About cue — soft-nav so the flyer runs.
        Everything else (logo, hash links, the #about deep-link) carries
        data-astro-reload and full-loads, and the home controller tears itself
        down on astro:before-swap, so it never has to survive a swap. */}
    <ClientRouter />
  </head>
  <body>
    {/* Nav + Cursor persist across soft swaps (transition:persist is on their
        own root elements) so their once-bound scripts — clock, reveal, crosshair
        — keep working instead of re-binding to fresh nodes each navigation. */}
    <Nav />
    <slot />
    <Cursor />
    <HoverCard />

    {/* The flyer travels in here; transition:persist keeps the layer (and the
        in-flight artwork) alive across the ClientRouter DOM swap. */}
    <div id="aoin-flight-layer" transition:persist="aoin-flight-layer" aria-hidden="true"></div>

    <script>
      import '@/lib/flight';
      import '@/lib/hovercard';
    </script>
  </body>
</html>
