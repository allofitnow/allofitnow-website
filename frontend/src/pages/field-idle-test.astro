---
/* PREVIZ — SITE-WIDE IDLE FIELD. Local only, not linked anywhere.
   A much sparser, more spread-out character field behind the whole site as an ambient idle
   animation (slow glyph flicker + a gentle per-glyph breathe), with the service and
   sub-service NAMES sprinkled through it as whole words among the characters. Move the
   mouse and the field displaces around the cursor (scatter + fade in a circle that follows
   you); keep moving and, after a short delay, the field DISSOLVES — every glyph drops out on
   its own random beat, not a uniform fade. Stop, and it dissolves back in the same way. */
import '../styles/services.css';

const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/';
// Sparse + spread: ~1/9 of cells lit, on a pitch roughly 2x wider and 2x taller than the
// services field. Generous grid so it overflows and fills any viewport (overflow clips).
const ROWS = 34, COLS = 130, DENSITY = 0.11;
// The names, sprinkled as whole words — one per row at most, never two rows adjacent.
const WORDS = [
  'REAL-TIME CONTENT', 'SCREENS PRODUCTION', 'MIXED REALITY', 'EQUIPMENT RENTAL',
  'INTERACTIVE CONTENT', 'LIVE GRAPHICS', 'CAMERA DESIGN', 'GENERATIVE SYSTEMS',
  'TECHNICAL DIRECTION', 'MEDIA SERVER PROGRAMMING', 'ON-SITE ENGINEERING',
  'DISGUISE SERVERS', 'RENDER NODES', 'CUSTOM RACK BUILDS', 'TRACKING SYSTEMS',
];

let seed = 21;
const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
type Cell = { g: string; on: boolean; w: boolean; sp?: boolean; last?: boolean; wlen?: number; dur: number; del: number; a: number; dd: number };
const rows: Cell[][] = [];
for (let r = 0; r < ROWS; r++) {
  const row: Cell[] = [];
  for (let c = 0; c < COLS; c++) {
    row.push({
      g: GLYPHS[(rnd() * GLYPHS.length) | 0],
      on: rnd() < DENSITY,
      w: false,
      dur: +(4 + rnd() * 5).toFixed(2),      // breathe period, s
      del: +(-rnd() * 9).toFixed(2),         // negative delay = desynchronised from load
      a: +(0.35 + rnd() * 0.45).toFixed(2),  // per-glyph base brightness
      dd: (rnd() * 650) | 0,                 // dissolve beat, ms — each glyph drops on its own
    });
  }
  rows.push(row);
}
// Write the words in. A word takes a row of its own (no neighbours above/below), and the
// cells it covers become word cells: always on, a little brighter, left out of the flicker.
const usedRows = new Set<number>();
for (const word of WORDS) {
  let r = -1;
  for (let tries = 0; tries < 40 && r < 0; tries++) {
    const cand = 1 + ((rnd() * (ROWS - 2)) | 0);
    if (!usedRows.has(cand) && !usedRows.has(cand - 1) && !usedRows.has(cand + 1)) r = cand;
  }
  if (r < 0) continue;
  usedRows.add(r);
  const c0 = (rnd() * (COLS - word.length - 2)) | 0;
  for (let k = 0; k < word.length; k++) {
    const cell = rows[r][c0 + k];
    // Every cell of the run is a word cell, the inner spaces included, so the whole run
    // takes the word tracking; the last cell carries the padding that puts the rest of
    // the row back on the field's pitch.
    cell.g = word[k]; cell.on = true; cell.w = true; cell.sp = word[k] === ' ';
    cell.last = k === word.length - 1; cell.wlen = word.length; cell.a = 0.92;
  }
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Idle field — site-wide test</title>
<link rel="preload" href="/fonts/SNJaMono-Light.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/DenimINKWD-Medium.woff2" as="font" type="font/woff2" crossorigin />
<style>
  html, body { margin: 0; height: 100%; background: #000; color: rgb(217, 225, 234); cursor: crosshair; }
  .stage { position: fixed; inset: 0; overflow: hidden; font-family: 'Denim INK WD', -apple-system, Arial, sans-serif; }

  /* The idle field: fixed behind everything. */
  .field {
    position: fixed; inset: 0; z-index: 0; padding: 40px 48px;
    font-family: 'SN Ja Mono', ui-monospace, Menlo, monospace;
    font-size: 12.5px; line-height: 52px; letter-spacing: 1.15em;
    color: rgb(217, 225, 234);
    overflow: hidden; pointer-events: none; user-select: none;
  }
  .frow { white-space: pre; }
  /* Each glyph breathes on its own clock, between ITS base brightness (--a) and full — so
     when the dissolve hands opacity back at --a, the animation resumes without a pop. */
  @keyframes breathe { 0%, 100% { opacity: var(--a); } 50% { opacity: 1; } }
  .fc {
    display: inline-block; vertical-align: baseline;
    animation: breathe var(--dur) ease-in-out var(--del) infinite;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1),
                opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Word cells: the names. Same face, held at a steadier brightness so they read, and set at
     a normal label tracking (0.28em) rather than the field's 1.15em pitch — the field is
     spread out, the words shouldn't be. Each cell's letter-spacing shrinks by 0.87em, so the
     run's last cell pads by 0.87em × its length and the rest of the row stays on the grid. */
  .fc.w { animation-duration: calc(var(--dur) * 1.6); letter-spacing: 0.28em; }
  .fc.w.wl { margin-right: var(--wpad, 0); }

  /* DISSOLVE, not fade: with the field hidden, every glyph drops to 0 on its own beat
     (--dd, 0–650ms), so the field breaks up rather than dimming as a sheet. Returning does
     the reverse — glyphs come back at their base brightness on the same random beats, then
     the breathe resumes from exactly that value. !important so it also takes glyphs that
     were mid-scatter (which carry inline opacity). */
  .field[data-hidden] .fc { animation: none; opacity: 0 !important; transition: opacity 240ms ease-out; transition-delay: var(--dd) !important; }
  .field[data-returning] .fc { animation: none; opacity: var(--a) !important; transition: opacity 320ms ease-in; transition-delay: var(--dd) !important; }

  /* Stand-in site content, to show the field lives BEHIND the page. */
  .content { position: absolute; left: 48px; right: 48px; top: 50%; transform: translateY(-50%); z-index: 1; pointer-events: none; }
  .h { font-weight: 500; font-size: clamp(56px, 9vw, 148px); line-height: 0.9; letter-spacing: -0.01em; }
  .sub { margin-top: 28px; font-family: 'SN Ja Mono', ui-monospace, Menlo, monospace; font-weight: 300; font-size: 14px; letter-spacing: 0.22em; color: rgba(217, 225, 234, 0.55); }

  .note { position: absolute; left: 48px; bottom: 24px; z-index: 2; font-family: 'SN Ja Mono', ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: 0.26em; color: rgba(217, 225, 234, 0.4); pointer-events: none; }
</style>
</head>
<body>
  <div class="stage">
    <div class="field" data-field>
      {rows.map((row) => (
        <div class="frow">
          {row.map((c) => (c.on
            ? <span class={c.w ? `fc w${c.sp ? ' sp' : ''}${c.last ? ' wl' : ''}` : 'fc'} style={`--dur:${c.dur}s;--del:${c.del}s;--a:${c.a};--dd:${c.dd}ms${c.last ? `;--wpad:${(c.wlen! * 0.87).toFixed(2)}em` : ''}`}>{c.g}</span>
            : ' '))}
        </div>
      ))}
    </div>

    <div class="content">
      <div class="h">ALL OF<br />IT NOW</div>
      <div class="sub">SITE-WIDE IDLE FIELD — STAND-IN CONTENT</div>
    </div>

    <div class="note">MOVE THE MOUSE: THE FIELD DISPLACES AROUND THE CURSOR, THEN DISSOLVES. STOP: IT DISSOLVES BACK IN.</div>
  </div>

  <script>
    const field = document.querySelector('[data-field]');
    const spans = Array.from(document.querySelectorAll('.fc'));
    const rand = spans.map(() => {
      const ang = Math.random() * Math.PI * 2;
      return { ux: Math.cos(ang), uy: Math.sin(ang), mag: 0.6 + Math.random() * 0.9, spin: (Math.random() * 2 - 1) * 45, delay: (Math.random() * 110) | 0 };
    });
    let centres = [];
    const cache = () => { centres = spans.map((s) => { const r = s.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; }); };

    // Displacement around the cursor: a circle of R px; the inner CORE fully clears, the
    // ring scatters outward (away from the cursor, plus each glyph's random vector) and fades.
    const R = 170, CORE = 0.42, SCATTER = 84;
    // Timing: keep moving for HIDE_AFTER ms and the field dissolves; stop for IDLE_AFTER ms
    // and it dissolves back in. The gap is what lets you SEE the displacement first.
    const HIDE_AFTER = 800, IDLE_AFTER = 1500, RETURN_MS = 1100;

    let active = new Set();
    const reset = (i) => { const s = spans[i]; s.style.transitionDelay = (rand[i].delay >> 1) + 'ms'; s.style.transform = ''; s.style.opacity = ''; s.style.animation = ''; };
    const clear = () => { active.forEach(reset); active = new Set(); };

    const displace = (mx, my) => {
      const next = new Set();
      for (let i = 0; i < spans.length; i++) {
        const c = centres[i];
        const dx = c.x - mx, dy = c.y - my;
        const d = Math.hypot(dx, dy);
        if (d < R) {
          const f = 1 - d / R;
          const e = f * f * (3 - 2 * f);
          const j = rand[i];
          const ol = d || 1;
          let vx = (dx / ol) * 0.8 + j.ux * 0.5, vy = (dy / ol) * 0.8 + j.uy * 0.5;
          const vl = Math.hypot(vx, vy) || 1; vx /= vl; vy /= vl;
          const dist = SCATTER * (0.35 + 0.65 * e) * j.mag;
          const s = spans[i];
          s.style.animation = 'none';           // hand opacity to the inline value below
          s.style.transitionDelay = j.delay + 'ms';
          s.style.transform = 'translate(' + (vx * dist).toFixed(1) + 'px,' + (vy * dist).toFixed(1) + 'px) rotate(' + (j.spin * e).toFixed(1) + 'deg)';
          s.style.opacity = d < R * CORE ? '0' : (1 - Math.min(1, e * 2.2) * 0.98).toFixed(3);
          next.add(i);
        }
      }
      active.forEach((i) => { if (!next.has(i)) reset(i); });
      active = next;
    };

    // State: idle (field showing) → moving (displacing; dissolves after HIDE_AFTER) → idle
    // again once the mouse has been still for IDLE_AFTER (dissolves back in over RETURN_MS,
    // then the breathe resumes).
    let lastMove = 0, activeSince = 0, hidden = false, lastRun = 0, returnT = 0;
    window.addEventListener('pointermove', (ev) => {
      if (!active.size) cache();              // positions can shift as fonts land; re-read per burst
      const now = performance.now();
      if (!activeSince) { activeSince = now; clearTimeout(returnT); field.removeAttribute('data-returning'); }
      lastMove = now;
      if (now - lastRun > 14) { lastRun = now; displace(ev.clientX, ev.clientY); }
      if (!hidden && now - activeSince > HIDE_AFTER) { hidden = true; field.setAttribute('data-hidden', ''); }
    });
    setInterval(() => {
      if (activeSince && performance.now() - lastMove > IDLE_AFTER) {
        activeSince = 0; hidden = false;
        clear();
        field.removeAttribute('data-hidden');
        field.setAttribute('data-returning', '');
        clearTimeout(returnT);
        returnT = setTimeout(() => field.removeAttribute('data-returning'), RETURN_MS);
      }
    }, 100);

    let rz; window.addEventListener('resize', () => { clearTimeout(rz); rz = setTimeout(() => { clear(); cache(); }, 150); });
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(cache); document.fonts.addEventListener('loadingdone', cache); } else cache();
    setTimeout(cache, 400); setTimeout(cache, 1600);

    // Idle flicker: slow, sparse — a few character glyphs (never the words) change now and then.
    const CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/';
    const plain = spans.filter((s) => !s.classList.contains('w'));
    setInterval(() => {
      const k = Math.max(2, (plain.length * 0.015) | 0);
      for (let n = 0; n < k; n++) {
        const s = plain[(Math.random() * plain.length) | 0];
        if (s && !s.style.transform) s.textContent = CH[(Math.random() * CH.length) | 0];
      }
    }, 260);
  </script>
</body>
</html>
