---
import Base from '@/layouts/Base.astro';
import Preloader from '@/components/home/Preloader.astro';
import Grain from '@/components/home/Grain.astro';
import Hero from '@/components/home/Hero.astro';
import About from '@/components/home/About.astro';
import Services from '@/components/home/Services.astro';
import Clients from '@/components/home/Clients.astro';
import Footer from '@/components/home/Footer.astro';
---

<Base>
  <div class="home" data-home>
    <Preloader />
    <Grain />
    <Hero />
    <About />
    <Services />
    <Clients />
    <Footer />
  </div>
</Base>

<style>
  .home {
    background: #000;
    color: var(--aoin-cool-white);
  }
</style>

<script>
  import { mountHome } from '@/lib/home.controller';
  let ctrl: ReturnType<typeof mountHome> | null = null;

  const mount = () => {
    const root = document.querySelector<HTMLElement>('[data-home]');
    if (!root || ctrl) return;
    ctrl = mountHome(root);
  };

  const unmount = () => {
    ctrl?.destroy();
    ctrl = null;
  };

  mount();

  // A home marquee tile flies to its project as a soft (ClientRouter) nav, so
  // tear the controller down on the way out — otherwise Lenis and its scroll
  // listeners leak onto the project page. The browser BACK button restores home
  // via the ClientRouter (NOT a full reload, despite data-astro-reload on the
  // links), so re-mount on swap — otherwise the restored preloader sits at 0%
  // forever (#156).
  document.addEventListener('astro:before-swap', unmount);
  document.addEventListener('astro:after-swap', mount);
  document.addEventListener('astro:page-load', mount);
</script>
