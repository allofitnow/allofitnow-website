---
import Base from '@/layouts/Base.astro';
import Preloader from '@/components/home/Preloader.astro';
import Grain from '@/components/home/Grain.astro';
import Hero from '@/components/home/Hero.astro';
import About from '@/components/home/About.astro';
import Services from '@/components/home/Services.astro';
import Clients from '@/components/home/Clients.astro';
import Footer from '@/components/home/Footer.astro';
import FootBar from '@/components/home/FootBar.astro';
---

<Base>
  <div class="home" data-home>
    <Preloader />
    <Grain />
    <Hero />
    <About />
    <Services />
    <Clients />
    <Footer />
    <FootBar />
  </div>
</Base>

<style>
  .home {
    background: #000;
    color: var(--aoin-cool-white);
  }
</style>

<script>
  import { mountHome } from '@/lib/home.controller';
  const root = document.querySelector<HTMLElement>('[data-home]');
  if (root) mountHome(root);
</script>
