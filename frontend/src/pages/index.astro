---
import Base from '@/layouts/Base.astro';
import Preloader from '@/components/home/Preloader.astro';
import Grain from '@/components/home/Grain.astro';
import Hero from '@/components/home/Hero.astro';
import About from '@/components/home/About.astro';
import Services from '@/components/home/Services.astro';
import Clients from '@/components/home/Clients.astro';
import Footer from '@/components/home/Footer.astro';
---

<Base>
  <div class="home" data-home>
    <Preloader />
    <Grain />
    <Hero />
    <About />
    <Services />
    <Clients />
    <Footer />
  </div>
</Base>

<style>
  .home {
    background: #000;
    color: var(--aoin-cool-white);
  }
</style>

<script>
  import { mountHome } from '@/lib/home.controller';
  const root = document.querySelector<HTMLElement>('[data-home]');
  if (root) {
    const c = mountHome(root);
    // A home marquee tile flies to its project as a soft (ClientRouter) nav, so
    // tear the controller down on the way out — otherwise Lenis and its scroll
    // listeners leak onto the project page. Returning to home is always a full
    // load (every home-bound link is data-astro-reload), so it re-mounts fresh.
    document.addEventListener('astro:before-swap', () => c.destroy(), { once: true });
  }
</script>
