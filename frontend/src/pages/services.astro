---
/* Services — a HORIZONTAL scroller. The WebGL "STUDIO / CAPABILITIES" hero and its
   capability bar are PERSISTENT chrome (the ported controller runs in intro-only mode:
   field + clock + bar sizing only). Vertical wheel/trackpad drives a 5-panel track
   sideways; as each service comes into focus the persistent bar SCRAMBLES to it
   (slot 0 = name, slots 1-3 = subcategories — mirroring the hero), its content slides
   and pops into place, and a bottom-right service nav tracks the active panel.

   The horizontal-scroll engine + entrance animations + orbit + equipment hover live in
   services-effects.js (Lenis + GSAP/ScrollTrigger). The intro chrome's data-attrs /
   inline styles are the controller's API — don't refactor them. The track deliberately
   avoids the controller's [data-panel]/[data-other]/[data-imgs]/[data-copy] attrs so the
   controller's layout() never touches it. The page is a full HTML doc outside Base.astro
   but uses the shared site nav. */
import '../styles/services.css';
import Nav from '../components/chrome/Nav.astro';
import HoverCard from '../components/chrome/HoverCard.astro';
import Preloader from '../components/home/Preloader.astro';
import PageTitle from '../components/services/PageTitle.astro';
import CapabilityBar from '../components/services/CapabilityBar.astro';
import AsciiField from '../components/services/AsciiField.astro';
import { getServiceSections, getServiceGalleries, type GalleryItem } from '../data/services';
import { getEquipment } from '../data/equipment';

const pad = (n: number) => String(n).padStart(2, '0');

// Section copy + gallery images — Payload-ready via a typed async accessor (local seed today,
// a Payload collection later). The galleries feed the ported Codrops "mwg" components.
const services = await getServiceSections();
const RTC = services[0].images;
const SCREENS = services[1].images;

// --- Storyboard / fill-in checklist ------------------------------------------------------------
// RTC + Screens render a FIXED grid of numbered flat cards; each CMS gallery item REPLACES the card
// at its position, so the live page doubles as a checklist of what's left to shoot/assign. A gallery
// item lands on its 1-based `slot` (set in Payload — the numbered card it replaces); slotless items
// drop into the first open position in list order. Empty positions stay numbered cards. Flip
// CHECKLIST to false to render the finished look (real stills only, no cards, seed fallback). ASPECT
// is a uniform 16/9 across every still + card (matches the Mixed-Reality orbit). Kept as a per-slot
// helper (still called at each render site) so mixed ratios can be reintroduced later without churn.
const CHECKLIST = true;
const RTC_SLOTS = 16;
const SCREENS_SLOTS = 12;
const pickAR = (_i: number) => '16 / 9';

// Place CMS gallery items into a fixed-length slot array: each on its 1-based `slot` (the card it
// replaces); slotless / colliding / out-of-range items fill the earliest gap. Grows past `target` if
// the CMS overflows it (or references a higher slot) so a still is never dropped. null = a card.
const buildSlots = (items: GalleryItem[], target: number): (GalleryItem | null)[] => {
  const maxSlot = items.reduce((m, it) => Math.max(m, typeof it.slot === 'number' ? it.slot : 0), 0);
  const count = Math.max(target, maxSlot, items.length);
  const slots: (GalleryItem | null)[] = Array.from({ length: count }, () => null);
  const overflow: GalleryItem[] = [];
  for (const it of items) {
    const idx = typeof it.slot === 'number' ? it.slot - 1 : -1;
    if (idx >= 0 && idx < count && !slots[idx]) slots[idx] = it;
    else overflow.push(it);
  }
  for (const it of overflow) {
    const k = slots.indexOf(null);
    if (k === -1) slots.push(it);
    else slots[k] = it;
  }
  return slots;
};

// CMS-only galleries (no seed fallback) → the checklist slot fill. Unfilled slots stay numbered.
const galleries = await getServiceGalleries();
const rtcSlots = buildSlots(galleries['real-time-content'] ?? [], RTC_SLOTS);
const screensSlots = buildSlots(galleries['screens-production'] ?? [], SCREENS_SLOTS);
// Mixed-reality orbit: a fixed-size ring of RING_SLOTS, cycling whatever stills the CMS provides to
// fill every slot (so 6 images comfortably fill a 10-slot ring). Fewer, larger slots = bigger images
// and a smaller gap. At radius 50vw with 28vw-wide images, 10 slots (360/10 = 36° apart, image ≈ 31°
// of arc) leave a ~5° gap. buildMixed() spaces whatever is rendered evenly at 360/count.
const RING_SLOTS = 10;
const mrSrc = services[2].images;
const MR = mrSrc.length
  ? Array.from({ length: RING_SLOTS }, (_, i) => mrSrc[i % mrSrc.length])
  : [];

const SVC_NAV = [
  { i: 0, label: 'REAL-TIME CONTENT' },
  { i: 1, label: 'SCREENS PRODUCTION' },
  { i: 2, label: 'MIXED REALITY' },
  { i: 3, label: 'EQUIPMENT RENTAL' },
];

// Equipment fleet — Payload-ready: a typed async accessor (local seed today, a Payload
// `equipment` collection later). Ordered left→right; one item is flagged `center`.
const equipment = await getEquipment();
const equipCenter = equipment.find((e) => e.center) ?? equipment[0];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Services — All Of It Now</title>
{/* Preloader count face — its @font-face is block, and the count animates from
    the first frame, so preload it or the numbers show blank until it loads. */}
<link rel="preload" href="/fonts/OOTheran-Light.otf" as="font" type="font/otf" crossorigin />
</head>
<body>
{/* Covers the raw stacked section layers (which paint for a frame before the
    effects module positions them off-stage) with the same branded LOADING beat
    as the homepage. Its render-blocking CSS means it's black on the first paint,
    so there's no flash; the bottom script lifts it once the stage is set. */}
<Preloader />
<Nav />
{/* Cursor-following project card — shows over project-linked stills (same rich card as the home
    marquee: name / tour / capabilities). Populated by lib/hovercard.ts from each still's data-*. */}
<HoverCard />

<!-- ===== Pinned viewport: persistent chrome + horizontal track ===== -->
<div class="svc-stage" data-root="" style="position:fixed;inset:0;overflow:hidden;isolation:isolate;background:#000;color:rgb(217,225,234);font-family:'Denim INK WD',sans-serif;font-weight:400">

  <!-- persistent chrome (never translated) -->
  <PageTitle />
  <CapabilityBar />
  <!-- empty stage: the controller measures it to place the field + fit the bar -->
  <div data-stage="" style="position:absolute;left:48px;right:48px;top:clamp(150px,22vh,240px);bottom:64px;pointer-events:none"></div>
  <AsciiField />

  <!-- stacked section layers: each is inset:0; the scroll engine scrubs their galleries -->
  <div class="svc-track" data-track="">

    <!-- REAL-TIME CONTENT — mwg_083 fly-across, scrubbed R→L -->
    <section class="svc-panel svc-panel--realtime" data-svc-panel="" data-i="0" id="real-time-content">
      <div class="mwg_effect083" data-fx="083">
        <div class="container">
          {CHECKLIST
            ? rtcSlots.map((g, i) => g
                ? <img class="media" style={`aspect-ratio:${pickAR(i)}`} src={g.src} alt="" loading="lazy" data-href={g.href} data-slug={g.slug} data-title={g.title} data-tour={g.tour} data-caps={g.caps} />
                : <div class="media previz-card" style={`aspect-ratio:${pickAR(i)}`}>{pad(i + 1)}</div>)
            : RTC.map((g, i) => <img class="media" style={`aspect-ratio:${pickAR(i)}`} src={g.src} alt="" loading="lazy" data-href={g.href} data-slug={g.slug} data-title={g.title} data-tour={g.tour} data-caps={g.caps} />)}
        </div>
      </div>
      <p class="svc-desc svc-desc--overlay" data-desc="">{services[0].desc}</p>
    </section>

    <!-- SCREENS PRODUCTION — mwg_051 columns, scrubbed bottom→top (fixed image set) -->
    <section class="svc-panel svc-panel--screens" data-svc-panel="" data-i="1" id="screens-production">
      <div class="mwg_effect051" data-fx="051">
        {CHECKLIST
          ? screensSlots.map((g, i) => g
              ? <img class="media" style={`aspect-ratio:${pickAR(i + 100)}`} src={g.src} alt="" loading="lazy" data-href={g.href} data-slug={g.slug} data-title={g.title} data-tour={g.tour} data-caps={g.caps} />
              : <div class="media previz-card" style={`aspect-ratio:${pickAR(i + 100)}`}>{pad(i + 1)}</div>)
          : SCREENS.map((g, i) => <img class="media" style={`aspect-ratio:${pickAR(i)}`} src={g.src} alt="" loading="lazy" data-href={g.href} data-slug={g.slug} data-title={g.title} data-tour={g.tour} data-caps={g.caps} />)}
      </div>
      <p class="svc-desc svc-desc--overlay" data-desc="">{services[1].desc}</p>
    </section>

    <!-- MIXED REALITY — mwg_061 3D orbit: assembles, then self-runs (scroll drives ring speed) -->
    <section class="svc-panel svc-panel--mixed" data-svc-panel="" data-i="2" id="mixed-reality">
      <div class="mwg_effect061" data-fx="061">
        <div class="container">
          {MR.map((g) => <img src={g.src} alt="" loading="lazy" data-href={g.href} data-slug={g.slug} data-title={g.title} data-tour={g.tour} data-caps={g.caps} />)}
        </div>
      </div>
      <p class="svc-desc svc-desc--overlay" data-desc="">{services[2].desc}</p>
    </section>

    <!-- EQUIPMENT RENTAL — server plate + a draggable one-line marquee of the fleet.
         Static until dragged; whichever name crosses page-center becomes active and swaps
         the plate + body copy (wired in services-effects.js initEquipment). -->
    <section class="svc-panel svc-panel--equip" data-svc-panel="" data-i="3" id="equipment-rental">
      <div class="equip" data-fx="equip">
        <div class="equip-plate" data-equip-plate>
          <img data-equip-img src={equipCenter.image} alt="" />
          <div class="equip-plate-ph" data-equip-ph aria-hidden="true"></div>
        </div>
        <div class="equip-marquee" data-equip-marquee aria-label="Drag to browse equipment">
          <div class="equip-track" data-equip-track>
            {equipment.map((e, i) => (
              <button
                type="button"
                class="equip-item"
                data-equip-row
                data-img={e.image}
                data-tip={e.tip}
                data-slug={e.slug}
                data-placeholder={e.placeholder ? 'true' : undefined}
                data-center={e.center ? 'true' : undefined}
                data-i={i}
              >{e.label}</button>
            ))}
          </div>
        </div>
      </div>
      <p class="svc-desc" data-desc="" data-equip-copy>{equipCenter.tip}</p>
    </section>

  </div>

  <!-- persistent bottom-right service nav -->
  <nav class="svc-nav" data-svc-nav="" aria-label="Services">
    {SVC_NAV.map((s) => (
      <button type="button" class="svc-nav-row" data-svc-jump data-i={s.i}>
        <span class="svc-nav-idx">{pad(s.i + 1)}</span><span class="svc-nav-label">{s.label}</span>
      </button>
    ))}
  </nav>

  <div data-hint="" class="svc-scrollhint" style="position:absolute;left:48px;bottom:16px;z-index:40;font-family:'SN Ja Mono',ui-monospace,Menlo,monospace;font-weight:300;font-size:10px;letter-spacing:.3em;color:rgba(217,225,234,0.45)">SCROLL TO EXPLORE</div>
</div>

<!-- scroll distance for the whole scrubbed narrative (intro → 4 sections) -->
<div class="svc-scrolldist" data-scroll="" style="height:900vh"></div>

<script>
  import gsap from 'gsap';
  import { mountServices } from '../scripts/services-controller.js';
  import { mountEffects } from '../scripts/services-effects.js';
  import '../lib/hovercard'; // cursor project card over project-linked stills (binds its own listeners)

  const ctrl = mountServices({ introOnly: true });
  // mountEffects positions every gallery off-stage synchronously (master.progress(0)),
  // so once it has run the preloader can lift with no raw-content behind it.
  mountEffects(ctrl);

  // Project-linked stills: clicking one plays a staggered, snappy transition OUT (not the Work→Project
  // flight — just a quick exit), then navigates to the project. Delegated on the stage so it covers all
  // three galleries (the engine gates pointer-events to the active section, so only the visible
  // section's stills are clickable). /services is a standalone doc → this is a full nav, and the project
  // page plays its own preloader (which covers the load). Stills with no project have no data-href.
  let leaving = false;
  const playExit = (section: Element | null, href: string) => {
    // Images fade in a stagger — opacity only, so the galleries' GSAP/3D transforms are untouched.
    const imgs = section ? [...section.querySelectorAll('img')] : [];
    const field = document.querySelector('[data-ascii]');
    // Chrome lifts + fades, snappy accelerating ease ("things leave, not drift").
    const lift = [
      document.querySelector('[data-title-a]'),
      document.querySelector('[data-title-b]'),
      ...document.querySelectorAll('[data-slot]'),
      section ? section.querySelector('[data-desc]') : null,
      ...document.querySelectorAll('[data-svc-jump]'),
    ].filter(Boolean);
    try { (window as any).__aoinLenis && (window as any).__aoinLenis.stop(); } catch (_) {}
    if (imgs.length) gsap.to(imgs, { opacity: 0, duration: 0.26, ease: 'power2.in', stagger: { each: 0.035 }, overwrite: 'auto' });
    if (field) gsap.to(field, { opacity: 0, duration: 0.3, ease: 'power2.in', overwrite: 'auto' });
    if (lift.length) gsap.to(lift, { y: -36, opacity: 0, duration: 0.4, ease: 'power3.in', stagger: 0.03, overwrite: 'auto' });
    // Tell the destination project page to skip its preloader count (this exit is the transition).
    try { sessionStorage.setItem('aoin-from-services', '1'); } catch (_) {}
    const ms = Math.min(560, 260 + imgs.length * 35);
    setTimeout(() => { window.location.href = href; }, ms);
  };
  document.querySelector('[data-root]')?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement | null;
    const img = t && t.closest ? (t.closest('img[data-href]') as HTMLElement | null) : null;
    const href = img && img.dataset ? img.dataset.href : '';
    if (!href || leaving) return;
    leaving = true;
    playExit(img ? img.closest('[data-svc-panel]') : null, href);
  });

  // --- Preloader lift ---------------------------------------------------------
  const pre = document.querySelector('[data-ref="preloader"]');
  const preCount = document.querySelector('[data-ref="preCount"]');
  const preLabel = document.querySelector('[data-ref="preLabel"]');
  const SLUGS = ['real-time-content', 'screens-production', 'mixed-reality', 'equipment-rental'];
  const deepLink = SLUGS.includes((location.hash || '').replace(/^#/, ''));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const lift = () => {
    if (!pre) return;
    [preLabel, preCount].filter(Boolean).forEach((el, i) =>
      el.animate(
        [{ transform: 'translateY(0%)' }, { transform: 'translateY(-115%)' }],
        { duration: 440, delay: 20 + i * 60, easing: 'cubic-bezier(.05,.89,0,.99)', fill: 'both' },
      ),
    );
    setTimeout(() => { pre.style.background = 'transparent'; }, 200);
    setTimeout(() => { pre.style.display = 'none'; }, 560);
  };

  if (pre && !deepLink && !reduced) {
    // Normal load: count 0 -> 100, then lift (the intro plays underneath).
    const dur = 1200;
    const t0 = performance.now();
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const step = (now) => {
      const t = Math.min(1, (now - t0) / dur);
      if (preCount) preCount.textContent = String(Math.round(ease(t) * 100));
      if (t < 1) requestAnimationFrame(step);
      else lift();
    };
    requestAnimationFrame(step);
  } else if (pre) {
    // Deep-link / reduced-motion: skip the count, just cover the flash until the
    // page has loaded (the deep-link jump lands on `load`), then lift.
    const go = () => setTimeout(lift, 60);
    if (document.readyState === 'complete') go();
    else window.addEventListener('load', go, { once: true });
  }
</script>
</body>
</html>
