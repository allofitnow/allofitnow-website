---
import Base from '@/layouts/Base.astro';
import { projects, type Project } from '@/data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;

const meta: [string, string][] = [
  ['CLIENT', project.client],
  ['YEAR', project.year],
  ['ROLE', project.role],
  ['SCOPE', project.scope],
];
---

<Base title={`${project.title} — All Of It Now`} description={project.body}>
  <main class="project" data-screen-label={project.title}>
    {/* data-slug marks the shared element the flight morphs from the work tile. */}
    <div class="hero" data-slug={project.slug} data-flight>
      <img src={project.hero} alt={project.title} />
    </div>

    <div class="p-copy">
      <h1 class="p-title" data-unit transition:name="aoin-pj-title">{project.title}</h1>

      <div class="p-meta" data-unit transition:name="aoin-pj-meta">
        {meta.map(([k, v]) => (
          <div>{k}<b>{v}</b></div>
        ))}
      </div>

      <p class="p-body" data-unit transition:name="aoin-pj-body">{project.body}</p>

      <a class="back" href="/work" data-unit data-flight data-go="work" transition:name="aoin-pj-back">
        [&nbsp;&nbsp;ALL WORK&nbsp;&nbsp;]
      </a>
    </div>
  </main>
</Base>

<style>
  .project {
    padding-top: var(--hero-pad-top);
  }
  .hero {
    position: relative;
    width: var(--hero-w);
    margin: 0 auto;
    height: var(--hero-height);
    overflow: hidden;
    border-radius: var(--hero-radius);
  }
  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-copy {
    width: var(--hero-w);
    margin: 0 auto;
    padding-top: 56px;
  }
  .p-title {
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: 1;
    font-size: clamp(46px, 8.6vw, 132px);
    letter-spacing: 0.02em;
  }
  .p-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 2px solid var(--aoin-cool-white-45);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--aoin-cool-white-45);
  }
  .p-meta b {
    display: block;
    margin-top: 8px;
    font-weight: var(--weight-mono);
    letter-spacing: 0.14em;
    color: var(--aoin-cool-white);
  }
  .p-body {
    max-width: 62ch;
    margin: 64px 0 40px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 15px;
    line-height: 1.75;
    color: var(--aoin-cool-white-45);
  }
  .back {
    display: inline-block;
    margin-bottom: 160px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    color: var(--aoin-cool-white);
  }

  @media (max-width: 720px) {
    .p-meta {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
</style>
