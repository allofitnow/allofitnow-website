---
import Base from '@/layouts/Base.astro';
import ProjectTile from '@/components/work/ProjectTile.astro';
import { projects } from '@/data/projects';

const count = String(projects.length).padStart(2, '0');
---

<Base title="Work — All Of It Now" description="Selected work from All Of It Now.">
  <main class="work" data-screen-label="Work">
    <div class="section-label" data-unit>
      <span>[ SELECTED WORK ]</span>
      <span>{count} PROJECTS</span>
    </div>

    <div class="grid" id="grid">
      {projects.map((p) => <ProjectTile project={p} />)}
    </div>

    {/* Shuffle the grid order on every load. is:inline so it re-runs on each
        ClientRouter navigation and executes synchronously (before paint, and
        before the flight measures the destination, so re-targeting stays exact). */}
    <script is:inline>
      (() => {
        const grid = document.getElementById('grid');
        if (!grid) return;
        const kids = Array.from(grid.children);
        for (let i = kids.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [kids[i], kids[j]] = [kids[j], kids[i]];
        }
        kids.forEach((k) => grid.appendChild(k));
      })();
    </script>

    <a class="back" href="/#about" data-unit data-flight data-go="home" data-astro-reload>
      [&nbsp;&nbsp;BACK&nbsp;&nbsp;]
    </a>
  </main>
</Base>

<style>
  .work {
    padding: var(--work-pad-top) var(--margin-edge) 140px;
    max-width: var(--content-max);
    margin-inline: auto;
    box-sizing: border-box;
  }
  .section-label {
    display: flex;
    justify-content: space-between;
    padding-bottom: 26px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--aoin-cool-white-45);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--tile-gap);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .work {
      padding-left: var(--margin-edge-mobile);
      padding-right: var(--margin-edge-mobile);
    }
  }
  .back {
    display: inline-block;
    margin-top: 60px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    color: var(--aoin-cool-white);
  }
</style>
