      grid-template-columns: 1fr;
      gap: 12px;
    }
    [data-expanded='true'] .pp__stats {
      width: 100%;
      font-size: 11px;
    }
    [data-expanded='true'] .pp__credits {
      width: 100%;
      font-size: 16px;
    }

    /* Page 2: the write-up as a full-screen panel that slides in from the right.
