---
/* AOIN — Project page. Ported from the design handoff (project-page.components.html
 * + project-page.spec.md). One boolean (data-expanded on the shell) drives a
 * full-page reflow: every block narrows to ~49% and the write-up panel opens in
 * the freed right column. Behaviour + the four measured values live in
 * lib/project-page.ts.
 *
 * Adapted for our app:
 *  - We keep the shared, persisted Nav + our real-timezone clock; the handoff's
 *    SiteNav is dropped (same call as the Work page).
 *  - The page caps at --content-max and centres, like the rest of the site. All
 *    the handoff's cqw math lives on an inner [data-pp-frame] that carries
 *    container-type; the FIXED chrome (toggle, panel, footer meta) sits OUTSIDE
 *    that frame so it stays viewport-fixed, and JS aligns it to the capped frame
 *    (--pp-edge) instead of the raw viewport.
 *  - The hero keeps data-slug + data-flight so the Work↔Project flight morph
 *    still lands on / launches from it.
 */
import type { Project } from '@/data/projects';
import Media from '@/components/Media.astro';
import ProjectBar from '@/components/work/ProjectBar.astro';
import { renderRichText } from '@/lib/richtext';

interface Props {
  project: Project;
  /** Prev/next roster neighbours, computed by the page (keeps this dumb). */
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;

// Meta data-block columns, derived from the authored fields (no new data).
const metaCols: { label: string; values: string[] }[] = [
  { label: 'YEAR', values: [project.year] },
  { label: 'COLLABORATOR', values: [project.collaborator] },
  { label: 'SERVICES', values: project.services },
];

// Prev / next projects — the ProjectBar's NEXT cluster links to `next`; `prev`
// stays in Props (page still computes wrap-around) but is unused here now.

// Gallery arrangements — how many image slots each layout preset fills.
// Extra images past the layout's slot count are ignored (never break the grid).
const GALLERY_SLOTS: Record<string, number> = {
  full: 1,
  'two-up': 2,
  'full-16-9': 1,
  'full-2-1': 1,
  'full-3-1': 1,
  'full-19-5': 1,
  'full-27-4': 1,
  'split-8-4': 2,
  'split-5-7': 2,
  'three-up': 3,
};

// Mobile swipe-cue copy — PLACEHOLDER labels, pending the naming call.
const CUE_STORY = 'THE STORY'; // page 1 → write-up
const CUE_WORK = 'THE WORK'; //   write-up → page 1
---

<main class="pp" data-pp data-expanded="false" data-screen-label={project.title}>
  <div class="pp__frame" data-pp-frame>
    {/* Mobile-only swipe cue (above the artist) — tap or swipe to the write-up. */}
    <button class="pp__cue pp__cue--fwd" data-pp-cue="open" type="button">»»»&nbsp;&nbsp;SWIPE FOR {CUE_STORY}&nbsp;&nbsp;»»»</button>

    {/* ---- Title: artist (flows) + tour (slides in on expand) ---- */}
    <div class="pp__titleRow" data-pp-title-row data-unit>
      <h1 class="pp__title"><span data-pp-title>{project.title}</span></h1>
      <div class="pp__tour" data-pp-tour>{project.tour}</div>
    </div>

    {/* ---- Hero: the flight landing/launch element ---- */}
    <div class="pp__hero" data-pp-hero data-slug={project.slug} data-flight>
      <Media src={project.image} alt={project.title} />
      <div class="pp__heroScrim"></div>
      <div class="pp__heroGrad"></div>
    </div>

    {/* ---- Content column ---- */}
    <div class="pp__content">
      <div class="pp__meta" data-unit>
        <div class="pp__metaCols">
          {metaCols.map((col) => (
            <div class="pp__metaCol" data-flow={col.values.length > 4 ? 'two' : null}>
              <div class="pp__metaLabel">{col.label}</div>
              <div class="pp__metaVals">
                {col.values.map((v) => <div>{v}</div>)}
              </div>
            </div>
          ))}
        </div>
        {/* The summary is the one authored block with no length limit, and a
            long one lands as a wall of type beside the meta columns. It clamps
            to four lines and folds out; the button only appears when there is
            something folded, which only JS can know (see the script below). */}
        <div class="pp__desc" data-pp-summary data-open="false">
          <p class="pp__descText">{project.summary}</p>
          <button class="pp__more" type="button" hidden>READ MORE</button>
        </div>
      </div>

      <div class="pp__galleryWrap">
        <section class="pp__gallery">
          {project.gallery.map((row) => (
            <div class={`pp__gRow pp__gRow--${row.layout}`}>
              {row.images.slice(0, GALLERY_SLOTS[row.layout] ?? row.images.length).map((src, i) => (
                <div class={`pp__g pp__g--slot${i + 1}`}>
                  <Media src={src} alt="" loading="lazy" />
                </div>
              ))}
            </div>
          ))}
        </section>
      </div>

      <section class="pp__stats">
        {project.stats.map((s) => (
          <div class="pp__stat">{s.label}<b>{s.value}</b></div>
        ))}
      </section>

      <section class="pp__credits">
        {project.credits.map((group) => (
          <>
            <div class="pp__creditsTitle">{group.title}</div>
            {group.entries.map((c) => (
              <div class="pp__credit">{c.title}
                <b>{c.url
                  ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  : c.name}</b>
              </div>
            ))}
          </>
        ))}
      </section>

    </div>
  </div>

  {/* ---- Fixed chrome (outside the container-type frame; aligned to it by JS) ----
       The ProjectBar carries the write-up toggle (PROJECT INFO, [data-pp-toggle]),
       ALL WORK (the tile) and NEXT — replacing the old fixed toggle + the foot's
       prev/next + all-work block. project-page.ts still owns the open state. */}
  <ProjectBar next={{ href: `/work/${next.slug}`, title: next.title, tour: next.tour }} />

  <aside class="pp__aside" id="pp-writeup" data-pp-aside aria-hidden="true">
    <div class="pp__notes" data-pp-notes>
      {/* Mobile-only swipe cue (top of the write-up) — tap or swipe back. */}
      <button class="pp__cue pp__cue--back" data-pp-cue="close" type="button">«««&nbsp;&nbsp;SWIPE FOR {CUE_WORK}&nbsp;&nbsp;«««</button>
      <div class="pp__notesLabel">[ PRODUCTION NOTES ]</div>
      <div class="pp__notesRich" data-cols={project.writeupColumns} set:html={renderRichText(project.writeup)}></div>
    </div>
  </aside>
</main>

<style>
  /* ============================ shell ============================ */
  .pp {
    position: relative;
    min-height: 100vh;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-bottom: 120px;
    color: var(--aoin-cool-white);
    /* Shared layout-transition timing (spec §0). --pp-edge / --pp-panel-w /
       --pp-*-top are written by JS; the fallbacks cover the pre-JS first paint. */
    --dl: 620ms cubic-bezier(0.16, 1, 0.3, 1);
    --pp-edge: 2.5%;
    --panel-delay: 0ms;
  }
  /* container-type lives HERE, not on .pp — so the fixed chrome (a .pp child,
     but NOT a frame descendant) stays viewport-fixed instead of scrolling. */
  .pp__frame {
    container-type: inline-size;
    width: 100%;
  }

  /* ============================ title ============================ */
  .pp__titleRow {
    position: relative;
    width: 95%;
    margin-left: 2.5%;
    box-sizing: content-box;
    padding-top: 12vh;
    padding-bottom: 50px;
    height: calc(clamp(46px, 9.4cqw, 148px) * 0.9);
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    transition: gap var(--dl);
    transition-delay: 168ms; /* stage 0, closing */
  }
  [data-expanded='true'] .pp__titleRow {
    justify-content: flex-start;
    gap: 0;
    transition-delay: 0ms; /* stage 0, opening */
  }
  .pp__title {
    margin: 0;
    flex: 0 1 auto;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: 0.9;
    letter-spacing: 0.01em;
    font-size: clamp(46px, 9.4cqw, 148px);
    /* The name scales with the reflow, on the same stage-0 timing as the hero.
       The fit script sets an explicit px target; this transitions between them. */
    transition: font-size var(--dl);
    transition-delay: 168ms; /* stage 0, closing */
  }
  [data-expanded='true'] .pp__title {
    transition-delay: 0ms; /* stage 0, opening */
  }
  .pp__title span {
    display: block;
    white-space: nowrap;
    max-width: 100%;
  }
  [data-expanded='true'] .pp__title span {
    max-width: calc(49cqw - 24px);
  }
  .pp__tour {
    position: absolute;
    left: 49cqw;
    bottom: 50px;
    width: max-content;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: clamp(13px, 1.25cqw, 21px);
    line-height: 1;
    letter-spacing: 0.14em;
    white-space: nowrap;
    transform: translateX(calc(46cqw - 100%));
    transition: transform var(--dl);
    transition-delay: 168ms;
  }
  [data-expanded='true'] .pp__tour {
    transform: translateX(0);
    transition-delay: 0ms;
  }

  /* ============================ hero ============================ */
  .pp__hero {
    position: relative;
    width: 95%;
    margin-left: 2.5%;
    height: 82vh;
    min-height: 520px;
    overflow: hidden;
    border-radius: var(--hero-radius);
    transition: width var(--dl), height var(--dl);
    transition-delay: 168ms; /* stage 0 */
  }
  [data-expanded='true'] .pp__hero {
    width: 46.55%;
    height: 46vh;
    min-height: 300px;
    transition-delay: 0ms;
  }
  .pp__hero img,
  .pp__hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pp__heroScrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0; /* dial per bright hero (scrimOpacity prop) */
  }
  .pp__heroGrad {
    position: absolute;
    inset: 0;
    opacity: 0; /* protection gradient (gradientOpacity prop) */
    background: linear-gradient(180deg, #000 8.9%, transparent 49.2%, #000 86.1%);
  }

  /* ============================ content ============================ */
  .pp__content {
    width: 95%;
    margin: 0 auto;
  }

  /* ---- meta ---- */
  .pp__meta {
    margin-top: 44px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0;
    width: 100%;
    transition: width var(--dl), gap var(--dl);
    transition-delay: 112ms; /* stage 2, closing */
  }
  [data-expanded='true'] .pp__meta {
    flex-direction: column;
    gap: 28px;
    width: 49%;
    transition-delay: 110ms; /* stage 2, opening */
  }
  .pp__metaCols {
    width: 40%;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    transition: width var(--dl);
    transition-delay: 140ms; /* stage 1, closing */
  }
  [data-expanded='true'] .pp__metaCols {
    width: 100%;
    transition-delay: 55ms; /* stage 1, opening */
  }
  .pp__metaCol {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.5;
    /* Trim the leading above the first line so the label caps sit at the box
       top — lines the subtitle caps up with the summary's cap height. */
    text-box: trim-both cap alphabetic;
  }
  .pp__metaLabel {
    color: var(--aoin-cool-white-45);
  }
  .pp__metaVals > div {
    /* An entry split across the column gap would read as two services. */
    break-inside: avoid;
  }
  /* A long SERVICES list is the one meta column that can run away with the
     block: five entries push it well past the summary beside it and leave a
     tall ragged edge. Past four, the list flows into two columns — balanced by
     the browser, so five reads as 3 + 2 and the markup never says where the
     break goes.

     The numbers here are measured off the live page, not guessed. The longest
     service name sets a 206px column, so YEAR + COLLABORATOR + two service
     columns + gaps come to 734px — and the block's own 40% is 730px at 1920.
     Four pixels short, which is enough to wrap "Previsualization Suite" onto a
     second line and undo the point of the exercise. So the block takes a floor
     of 740px when a column flows, which still leaves a 263px gutter before the
     summary at 1920 and 85px at the container-query threshold.

     That threshold is where the arithmetic stops working: below it the meta
     block cannot hold 740px without running into the summary, so the list
     stays in one column rather than colliding. */
  @container (min-width: 1500px) {
    .pp__metaCol[data-flow='two'] .pp__metaVals {
      columns: 2;
      column-gap: 22px;
    }
    .pp__metaCols:has(.pp__metaCol[data-flow='two']) {
      width: max(40%, 740px);
    }
  }
  /* With the write-up open the meta block is down to 49% and there is no room
     for a second column, so it goes back to one. */
  [data-expanded='true'] .pp__metaCol[data-flow='two'] .pp__metaVals {
    columns: 1;
  }
  [data-expanded='true'] .pp__metaCols:has(.pp__metaCol[data-flow='two']) {
    width: 100%;
  }
  .pp__desc {
    width: 45%;
    margin: 0;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    font-size: clamp(18px, 1.5cqw, 32px);
    line-height: 1.25;
    text-transform: none; /* summary reads as authored (sentence case), not the site-wide uppercase */
    text-box: trim-both cap alphabetic;
    text-wrap: pretty;
    transition: width var(--dl), font-size var(--dl);
    transition-delay: 140ms; /* stage 1 */
  }
  .pp__descText {
    margin: 0;
    /* Four lines, then the fold. -webkit-line-clamp is the only form every
       engine here honours; `line-clamp` rides alongside it for the day that
       changes. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    /* Clipped in BOTH states, not just when folded: the closing animation
       shrinks the box while the text is still fully laid out inside it, and
       anything visible would spill over the gallery on the way down. */
    overflow: hidden;
  }
  /* Open is a BIGGER clamp, not no clamp. Unsetting it takes the element out
     of -webkit-box layout, and `text-box: trim-both` then trims differently —
     measured at 8.5px, which the eye catches as the copy jumping up the moment
     the fold finishes closing. Staying in the same layout mode costs nothing
     and moves nothing. */
  [data-pp-summary][data-open='true'] .pp__descText {
    -webkit-line-clamp: 9999;
    line-clamp: 9999;
  }
  .pp__more {
    margin-top: 14px;
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    color: var(--aoin-cool-white-45);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 240ms var(--ease-brand), border-color 240ms var(--ease-brand);
  }
  .pp__more:hover {
    color: var(--aoin-cool-white);
    border-color: var(--aoin-cool-white);
  }
  .pp__more[hidden] {
    display: none;
  }
  [data-expanded='true'] .pp__desc {
    width: 100%;
    font-size: 20px;
    transition-delay: 55ms;
  }

  /* ---- gallery (arrangements) ---- */
  .pp__galleryWrap {
    display: block; /* the panel is fixed, so no flex row is needed here */
  }
  /* The gallery is now a vertical stack of authored rows; each row lays its
     own slots on the shared 12-col grid. */
  .pp__gallery {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-top: 72px;
    transition: width var(--dl), gap var(--dl);
    transition-delay: 84ms; /* stage 3, closing */
  }
  [data-expanded='true'] .pp__gallery {
    width: 49%;
    gap: 24px;
    transition-delay: 165ms; /* stage 3, opening */
  }
  .pp__gRow {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 80px;
    align-items: start;
    transition: gap var(--dl);
    transition-delay: 84ms;
  }
  [data-expanded='true'] .pp__gRow {
    gap: 24px;
    transition-delay: 165ms;
  }
  .pp__g {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }
  .pp__g img,
  .pp__g video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Layout presets — fixed aspect ratios per slot, keeping the page's rhythm.
     The two asymmetric splits mirror the old a/b and c/d tiles. */
  .pp__gRow--full .pp__g { grid-column: 1 / -1; aspect-ratio: 16 / 7; }
  /* The same full-width row at other heights, so an editor can match the row to
     the picture instead of the picture being cropped to the row. */
  .pp__gRow--full-16-9 .pp__g { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  .pp__gRow--full-2-1 .pp__g  { grid-column: 1 / -1; aspect-ratio: 2 / 1; }
  .pp__gRow--full-3-1 .pp__g  { grid-column: 1 / -1; aspect-ratio: 3 / 1; }
  /* 19/5 is 3.8:1; 27/4 is 6.75:1 — for LED-canvas panoramas. */
  .pp__gRow--full-19-5 .pp__g { grid-column: 1 / -1; aspect-ratio: 19 / 5; }
  .pp__gRow--full-27-4 .pp__g { grid-column: 1 / -1; aspect-ratio: 27 / 4; }
  .pp__gRow--two-up .pp__g { grid-column: span 6; aspect-ratio: 4 / 3; }
  .pp__gRow--split-8-4 .pp__g--slot1 { grid-column: 1 / span 8; aspect-ratio: 16 / 9; }
  .pp__gRow--split-8-4 .pp__g--slot2 { grid-column: 9 / span 4; align-self: end; aspect-ratio: 1 / 1; }
  .pp__gRow--split-5-7 .pp__g--slot1 { grid-column: 1 / span 5; aspect-ratio: 4 / 3; }
  .pp__gRow--split-5-7 .pp__g--slot2 { grid-column: 6 / span 7; align-self: end; aspect-ratio: 16 / 9; }
  .pp__gRow--three-up .pp__g { grid-column: span 4; aspect-ratio: 4 / 3; }

  /* ---- stats ---- */
  .pp__stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 12px;
    margin-top: 72px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--aoin-cool-white-45);
    transition: width var(--dl);
    transition-delay: 56ms; /* stage 4, closing */
  }
  [data-expanded='true'] .pp__stats {
    width: 49%;
    font-size: 10px; /* step change, NOT transitioned (only width is) */
    transition-delay: 220ms; /* stage 4, opening */
  }
  .pp__stat { grid-column: span 3; }
  .pp__stat b {
    display: block;
    font-weight: var(--weight-mono);
    color: var(--aoin-cool-white);
    margin-top: 8px;
    font-size: 2.4em;
    letter-spacing: 0.04em;
  }

  /* ---- credits ---- */
  .pp__credits {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 34px 12px;
    margin-top: 48px;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    font-size: 18px;
    letter-spacing: 0.04em;
    transition: width var(--dl);
    transition-delay: 28ms; /* stage 5, closing */
  }
  [data-expanded='true'] .pp__credits {
    width: 49%;
    font-size: 15px; /* step change, NOT transitioned */
    transition-delay: 275ms; /* stage 5, opening */
  }
  .pp__creditsTitle {
    grid-column: 1 / -1;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: 2em;
    letter-spacing: 0.01em; /* match the big Denim titles (artist name, NEXT PROJECT) */
    margin-bottom: 2px;
  }
  .pp__credit {
    grid-column: span 3;
    color: var(--aoin-cool-white-45);
    font-size: 14px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
  }
  .pp__credit b {
    display: block;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    color: var(--aoin-cool-white);
    margin-top: 8px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    word-break: break-word;
  }
  .pp__credit a {
    color: inherit;
    text-decoration: none;
    text-transform: uppercase; /* visible text only — href keeps the real handle */
    border-bottom: 1px solid rgba(217, 225, 234, 0.28);
  }

  /* ============================ fixed chrome (write-up aside) ============================
     The action controls (write-up toggle, all-work, next) now live in the
     ProjectBar; only the write-up panel remains as fixed chrome here. */
  .pp__aside {
    position: fixed;
    top: var(--pp-aside-top, 148px);
    right: var(--pp-edge);
    width: 0;
    max-height: var(--pp-aside-maxh, calc(100vh - 148px - 92px));
    overflow: hidden;
    box-sizing: border-box;
    z-index: 15;
    pointer-events: none;
    opacity: 0;
    transition:
      width 500ms cubic-bezier(0.16, 1, 0.3, 1) var(--panel-delay),
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1) var(--panel-delay);
  }
  [data-expanded='true'] .pp__aside {
    width: var(--pp-panel-w, 46vw);
    opacity: 1;
    pointer-events: auto;
  }
  .pp__notes {
    width: var(--pp-panel-w, 46vw);
    box-sizing: border-box;
    padding-right: 18px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pp__notesLabel {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--aoin-cool-white-45);
  }
  /* Rendered write-up (rich text), set in Denim; the first paragraph reads as
     the lede. NB: the content is injected via set:html, so Astro's scoped
     selectors can't tag it — set the base type on the (scoped) container so the
     injected children inherit it, and use :global() for the per-element rules. */
  .pp__notesRich {
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* Opt out of the global uppercase — the write-up reads as authored. */
    text-transform: none;
    /* Base prose type — inherited by the injected content (Denim, not serif). */
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--aoin-cool-white-45);
  }
  .pp__notesRich :global(p) {
    margin: 0;
  }
  .pp__notesRich :global(ul),
  .pp__notesRich :global(ol) {
    margin: 0;
    padding-left: 1.2em;
  }
  .pp__notesRich :global(h1),
  .pp__notesRich :global(h2),
  .pp__notesRich :global(h3),
  .pp__notesRich :global(h4),
  .pp__notesRich :global(h5),
  .pp__notesRich :global(h6) {
    margin: 4px 0 0;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--aoin-cool-white);
  }
  .pp__notesRich :global(strong) {
    color: var(--aoin-cool-white);
    font-weight: var(--weight-headline);
  }
  .pp__notesRich :global(a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(217, 225, 234, 0.28);
  }
  .pp__notesRich :global(p:first-of-type) {
    font-weight: var(--weight-body);
    font-size: 20px;
    line-height: 1.45;
    color: var(--aoin-cool-white);
    text-wrap: pretty;
  }

  /* ---- two-column flow (writeupColumns on the project) ----
     Multi-column, not grid: the copy has to FLOW between the columns. A grid
     would make the editor decide, per block, which side each paragraph lands
     on. The `300px 2` shorthand caps it at two columns and drops back to one
     the moment they'd be narrower than 300px — which is what happens on the
     mobile panel (100% wide) and on a small laptop, so no breakpoint needed. */
  .pp__notesRich[data-cols='2'] {
    display: block;
    columns: 300px 2;
    column-gap: 34px;
  }
  .pp__notesRich[data-cols='2'] :global(> *) {
    /* the flex gap is gone with display:block — space the blocks by margin */
    margin: 0 0 20px;
    /* a paragraph broken across the column gap reads as two paragraphs */
    break-inside: avoid;
  }
  .pp__notesRich[data-cols='2'] :global(p:first-of-type) {
    /* the lede runs the full measure; the body breaks into columns under it */
    column-span: all;
    margin-bottom: 26px;
  }

  /* ---- inline media (an `upload` node in the write-up) ----
     Serialized by lib/richtext.ts as <figure class="rt-fig rt-fig--full|half">.
     Unlike the gallery these are NOT cropped to a fixed row: the figure takes
     the media's own aspect ratio, because in prose the picture is an aside, not
     a slot to be filled. */
  .pp__notesRich :global(.rt-fig) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    break-inside: avoid;
  }
  .pp__notesRich :global(.rt-fig img),
  .pp__notesRich :global(.rt-fig video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px; /* matches the gallery tiles */
  }
  .pp__notesRich :global(.rt-fig figcaption) {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--aoin-cool-white-35);
  }
  /* FULL breaks out across both columns; ONE COLUMN stays in the text flow.
     With one column there is nothing to span, so ONE COLUMN just renders
     narrower — the setting still means something either way. */
  .pp__notesRich[data-cols='2'] :global(.rt-fig--full) {
    column-span: all;
  }
  .pp__notesRich[data-cols='1'] :global(.rt-fig--half) {
    width: 62%;
  }

  /* ---- the rest of the toolbar ---- */
  .pp__notesRich :global(blockquote) {
    margin: 0;
    padding-left: 14px;
    border-left: 1px solid rgba(217, 225, 234, 0.28);
    color: var(--aoin-cool-white);
  }
  .pp__notesRich :global(.rt-indent) {
    padding-left: 1.4em;
  }
  .pp__notesRich :global(s) {
    opacity: 0.6;
  }
  .pp__notesRich :global(code) {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 0.92em;
  }

  /* ---- mobile swipe cue (desktop: hidden; shown in the mobile block) ---- */
  .pp__cue {
    display: none;
  }
  /* A soft black gradient sweeps through the text to denote the swipe
     direction — forward (»») sweeps left→right, back («») sweeps right→left. */
  @keyframes pp-cue-sweep-r {
    from { transform: translateX(-110%); }
    to { transform: translateX(110%); }
  }
  @keyframes pp-cue-sweep-l {
    from { transform: translateX(110%); }
    to { transform: translateX(-110%); }
  }

  /* ============================ reduced motion ============================ */
  @media (prefers-reduced-motion: reduce) {
    .pp * {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ============================ mobile ============================
     Phones can't do the desktop 2-up compress, so the write-up is a full-screen
     panel you swipe (or tap the bottom button) to: the project content slides
     off-left and the notes slide in from the right (see project-page.ts). */
  @media (max-width: 720px) {
    :global(html) {
      overflow-x: hidden; /* contain the off-screen slide panels */
    }
    .pp {
      padding-bottom: 128px;
    }
    .pp__titleRow {
      display: block;
      height: auto;
      width: 90%;
      margin-left: 5%;
      padding-top: 6px; /* the swipe cue above provides the top clearance now */
      padding-bottom: 28px;
    }

    /* The swipe cue — a small mono line with a black gradient sweeping through
       it to hint the direction. Tappable, and the whole page is swipeable. */
    .pp__cue {
      display: block;
      position: relative;
      overflow: hidden;
      width: max-content;
      max-width: 90%;
      margin: 0 auto;
      padding: 5px 2px;
      background: none;
      border: 0;
      cursor: pointer;
      font-family: var(--font-mono);
      font-weight: var(--weight-mono);
      font-size: 11px;
      letter-spacing: 0.22em;
      color: var(--aoin-cool-white);
      white-space: nowrap;
    }
    .pp__cue::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, transparent 32%, #000 50%, transparent 68%);
    }
    .pp__cue--fwd {
      margin-top: 13vh; /* clears the fixed nav */
      margin-bottom: 22px;
    }
    .pp__cue--fwd::after {
      animation: pp-cue-sweep-r 2.6s linear infinite;
    }
    .pp__cue--back::after {
      animation: pp-cue-sweep-l 2.6s linear infinite;
    }
    .pp__title {
      font-size: clamp(40px, 15vw, 88px);
    }
    .pp__title span {
      max-width: 100% !important;
    }
    .pp__tour {
      position: static;
      transform: none !important;
      width: 100%;
      margin-top: 12px;
      text-align: center; /* centre the tour under the artist name */
    }
    .pp__hero {
      width: 90%;
      margin-left: 5%;
      height: 62vh;
      min-height: 360px;
    }
    .pp__content {
      width: 90%;
    }
    .pp__meta {
      flex-direction: column;
      gap: 24px;
    }
    .pp__metaCols,
    .pp__desc {
      width: 100% !important;
    }
    /* Belt and braces with the container query above: a phone never has the
       1400px that would turn this on. */
    .pp__metaCol[data-flow='two'] .pp__metaVals {
      columns: 1;
    }
    .pp__desc {
      margin-top: 4px;
      font-size: clamp(18px, 5vw, 24px);
    }
    .pp__gallery {
      gap: 12px;
    }
    /* Every arrangement collapses to a single full-width column on phones. */
    .pp__gRow {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .pp__g {
      grid-column: 1 / -1 !important;
      align-self: auto !important;
      height: auto;
      aspect-ratio: 16 / 9 !important;
    }
    .pp__stats {
      gap: 24px 12px;
      font-size: 11px;
    }
    .pp__stat {
      grid-column: span 6;
    }
    .pp__credits {
      font-size: 16px;
    }
    .pp__credit {
      grid-column: span 6;
    }
    /* Page 1 (the project content) slides off-left when the write-up opens —
       a clean linear screen-slide, like paging between two app screens. */
    .pp__frame {
      transition: transform 0.45s linear;
    }
    [data-expanded='true'] .pp__frame {
      transform: translateX(-100%);
    }

    /* The expand is a SLIDE here, not the desktop compress: freeze the frame's
       content at its mobile layout in BOTH states and kill the per-element
       transitions, so nothing scales or reflows as a screen slides in/out. */
    .pp__frame * {
      transition: none !important;
    }
    [data-expanded='true'] .pp__hero {
      width: 90%;
      height: 62vh;
      min-height: 360px;
    }
    [data-expanded='true'] .pp__meta {
      width: 100%;
    }
    [data-expanded='true'] .pp__desc {
      width: 100%;
      font-size: clamp(18px, 5vw, 24px);
    }
    [data-expanded='true'] .pp__gallery {
      width: 100%;
      gap: 12px;
    }
    [data-expanded='true'] .pp__gRow {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    [data-expanded='true'] .pp__stats {
      width: 100%;
      font-size: 11px;
    }
    [data-expanded='true'] .pp__credits {
      width: 100%;
      font-size: 16px;
    }

    /* Page 2: the write-up as a full-screen panel that slides in from the right.
       Sits under the nav (top pad clears it), over the rest (z-index 15 base). */
    .pp__aside {
      position: fixed;
      inset: 0;
      width: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 92px 5% 108px;
      box-sizing: border-box;
      background: #000;
      overflow-x: hidden;
      overflow-y: auto;
      opacity: 1;
      pointer-events: auto;
      transform: translateX(100%);
      transition: transform 0.45s linear;
    }
    [data-expanded='true'] .pp__aside {
      transform: translateX(0);
      /* override the desktop [data-expanded] rule (var(--pp-panel-w) = ~46vw),
         which otherwise wins on specificity and leaves the panel half-width */
      width: 100%;
    }
    .pp__notes {
      width: 100% !important;
      padding-right: 0;
    }
    .pp__notesRich > p:first-of-type {
      font-size: 18px;
    }
  }
</style>

<script>
  import { initProjectPage } from '@/lib/project-page';

  // Inline write-up video: the figure ships with a 16/9 placeholder ratio (see
  // lib/richtext.ts — Payload stores no dimensions for video), so swap in the
  // real one as soon as the metadata lands. A vertical clip would otherwise sit
  // letterboxed in a landscape box for the life of the page.
  const fitWriteupVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('.pp__notesRich .rt-fig video').forEach((v) => {
      const apply = () => {
        if (v.videoWidth && v.videoHeight) v.style.aspectRatio = `${v.videoWidth} / ${v.videoHeight}`;
      };
      if (v.readyState >= 1) apply();
      else v.addEventListener('loadedmetadata', apply, { once: true });
    });
  };

  // The summary's fold. Whether there is anything TO fold is a measured
  // question, not an authored one: the same words are four lines at one width
  // and nine at another, and the panel opening drops the type from 32px to
  // 20px underneath it. So the button appears only when the clamped box is
  // actually hiding something, and that is re-checked whenever the geometry
  // can have changed.
  const initSummaryFold = () => {
    const box = document.querySelector<HTMLElement>('[data-pp-summary]');
    const text = box?.querySelector<HTMLElement>('.pp__descText');
    const button = box?.querySelector<HTMLButtonElement>('.pp__more');
    if (!box || !text || !button) return;

    // Height cannot transition to or from `auto`, so the fold animates between
    // two numbers measured either side of the clamp coming off. The page
    // reflows around it for free, because the summary is in normal flow —
    // the gallery below simply gets pushed.
    //
    // The curve is --bar-ease, the house 'glide' the bars and the contact
    // modal already run on, and NOT --ease-brand. Sampled on the real 333px
    // reveal, the brand curve is 49% done at 47ms and 81% at 92ms: built for
    // flights, where a fast start reads as decisive, but on a block of text it
    // reads as a snap with a long tail rather than as copy unfolding. The
    // glide runs 13 / 36 / 61 / 80 / 94% across the same time, which is the
    // shape the eye expects from something opening.
    const OPEN_MS = 520;
    let closedHeight = 0;

    const animate = (from, to, settle?: () => void) => {
      // Reduced motion: the site turns every transition off, so waiting for a
      // transitionend that will never fire would leave the box stuck at an
      // inline height.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        settle?.();
        text.style.height = '';
        return;
      }
      text.style.height = `${from}px`;
      void text.offsetHeight; // commit the start, or the browser sees one hop
      text.style.transition = `height ${OPEN_MS}ms var(--bar-ease)`;
      text.style.height = `${to}px`;

      const done = () => {
        text.removeEventListener('transitionend', done);
        clearTimeout(timer);
        // The clamp goes back on BEFORE the inline height is dropped, or the
        // box flashes at full height for a frame on the way closed.
        settle?.();
        text.style.transition = '';
        text.style.height = '';
      };
      // transitionend does not fire if the transition is interrupted or never
      // starts; the timer is what stops that leaving an inline height behind.
      const timer = setTimeout(done, OPEN_MS + 120);
      text.addEventListener('transitionend', done);
    };

    const measure = () => {
      // While open the clamp is off, so there is nothing to measure against —
      // an open fold keeps its button regardless.
      if (box.dataset.open === 'true') return;
      // NOT `scrollHeight > clientHeight`. `text-box: trim-both` cuts the
      // leading above the first line and below the last, so a paragraph that
      // fits exactly still reports a scrollHeight around nine pixels taller
      // than its client box — measured on a real four-line summary, which
      // offered a READ MORE that revealed nothing. The question is whether a
      // whole LINE is hidden, so half a line is the threshold.
      const line = parseFloat(getComputedStyle(text).lineHeight) || 0;
      button.hidden = text.scrollHeight - text.clientHeight < line * 0.5;
      // Folded, the client box IS the clamped height — worth keeping, because
      // by the time it is needed the clamp is off and it cannot be read again.
      closedHeight = text.clientHeight;
    };

    button.addEventListener('click', () => {
      const opening = box.dataset.open !== 'true';
      button.textContent = opening ? 'READ LESS' : 'READ MORE';
      const from = text.clientHeight;

      if (opening) {
        box.dataset.open = 'true'; // the clamp opens up; nothing is clipped now
        // The natural height, read before any inline height is set — and NOT
        // scrollHeight, which ignores the 9px `text-box` trim and would leave
        // the box to settle back by that much at the end.
        animate(from, text.getBoundingClientRect().height);
      } else {
        // Shrink first and re-clamp at the end: re-clamping now would snap the
        // box shut and leave nothing to animate.
        animate(from, closedHeight, () => {
          box.dataset.open = 'false';
        });
      }
    });

    measure();
    // Webfonts land after first paint and change the line count under us.
    document.fonts?.ready.then(measure);
    new ResizeObserver(measure).observe(text);
  };

  const boot = () => {
    const root = document.querySelector<HTMLElement>('[data-pp]');
    if (root) initProjectPage(root);
    fitWriteupVideos();
    initSummaryFold();
  };

  boot();
  // Under the ClientRouter, a soft-nav arrival (the flight) fires page-load.
  document.addEventListener('astro:page-load', boot);
</script>
