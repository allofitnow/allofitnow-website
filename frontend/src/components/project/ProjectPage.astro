---
/* AOIN — Project page. Ported from the design handoff (project-page.components.html
 * + project-page.spec.md). One boolean (data-expanded on the shell) drives a
 * full-page reflow: every block narrows to ~49% and the write-up panel opens in
 * the freed right column. Behaviour + the four measured values live in
 * lib/project-page.ts.
 *
 * Adapted for our app:
 *  - We keep the shared, persisted Nav + our real-timezone clock; the handoff's
 *    SiteNav is dropped (same call as the Work page).
 *  - The page caps at --content-max and centres, like the rest of the site. All
 *    the handoff's cqw math lives on an inner [data-pp-frame] that carries
 *    container-type; the FIXED chrome (toggle, panel, footer meta) sits OUTSIDE
 *    that frame so it stays viewport-fixed, and JS aligns it to the capped frame
 *    (--pp-edge) instead of the raw viewport.
 *  - The hero keeps data-slug + data-flight so the Work↔Project flight morph
 *    still lands on / launches from it.
 */
import type { Project } from '@/data/projects';
import Media from '@/components/Media.astro';
import ProjectBar from '@/components/work/ProjectBar.astro';
import { renderWriteup, renderInline } from '@/lib/richtext';

interface Props {
  project: Project;
  /** Prev/next roster neighbours, computed by the page (keeps this dumb). */
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;

// Meta data-block columns, derived from the authored fields (no new data).
const metaCols: { label: string; values: string[] }[] = [
  { label: 'YEAR', values: [project.year] },
  { label: 'COLLABORATOR', values: [project.collaborator] },
  { label: 'SERVICES', values: project.services },
];

// Prev / next projects — the ProjectBar's NEXT cluster links to `next`; `prev`
// stays in Props (page still computes wrap-around) but is unused here now.

// Gallery arrangements — how many image slots each layout preset fills.
// Extra images past the layout's slot count are ignored (never break the grid).
const GALLERY_SLOTS: Record<string, number> = {
  full: 1,
  'two-up': 2,
  'full-16-9': 1,
  'full-2-1': 1,
  'full-3-1': 1,
  'full-19-5': 1,
  'full-27-4': 1,
  'split-8-4': 2,
  'split-5-7': 2,
  'three-up': 3,
};

// #58 responsive hints per row layout (layout-audit table in issue #58). One
// entry per SLOT when the slots differ (split rows), else one per row.
const GALLERY_SIZES: Record<string, string> = {
  full: '(max-width:480px) 90vw, 95vw',
  'full-16-9': '(max-width:480px) 90vw, 95vw',
  'full-2-1': '(max-width:480px) 90vw, 95vw',
  'full-3-1': '(max-width:480px) 90vw, 95vw',
  'full-19-5': '(max-width:480px) 90vw, 95vw',
  'full-27-4': '(max-width:480px) 90vw, 95vw',
  'two-up': '(max-width:480px) 90vw, 45vw',
  'three-up': '(max-width:480px) 90vw, 28vw',
  // split rows: slot1 carries the wider cell; measured both slots at once.
  'split-8-4': '(max-width:480px) 90vw, 63vw',
  'split-5-7': '(max-width:480px) 90vw, 56vw',
};

// Mobile swipe-cue copy — PLACEHOLDER labels, pending the naming call.
const CUE_STORY = 'THE STORY'; // page 1 → write-up
const CUE_WORK = 'THE WORK'; //   write-up → page 1
---

<main class="pp" data-pp data-expanded="false" data-screen-label={project.title}>
  <div class="pp__frame" data-pp-frame>
    {/* Mobile-only swipe cue (above the artist) — tap or swipe to the write-up. */}
    <button class="pp__cue pp__cue--fwd" data-pp-cue="open" type="button">»»»&nbsp;&nbsp;SWIPE FOR {CUE_STORY}&nbsp;&nbsp;»»»</button>

    {/* ---- Title: artist (flows) + tour (slides in on expand) ---- */}
    <div class="pp__titleRow" data-pp-title-row data-unit>
      <h1 class="pp__title"><span data-pp-title>{project.title}</span></h1>
      <div class="pp__tour" data-pp-tour>{project.tour}</div>
    </div>

    {/* ---- Hero: the flight landing/launch element ---- */}
    <div class="pp__hero" data-pp-hero data-slug={project.slug} data-flight>
      <Media src={project.image} doc={project.imageDoc} alt={project.title} priority sizes="(max-width:480px) 90vw, 95vw" />
      <div class="pp__heroScrim"></div>
      <div class="pp__heroGrad"></div>
    </div>

    {/* ---- Content column ---- */}
    <div class="pp__content">
      <div class="pp__meta" data-unit>
        <div class="pp__metaCols">
          {metaCols.map((col) => (
            <div class="pp__metaCol" data-flow={col.values.length > 4 ? '' : null}>
              <div class="pp__metaLabel">{col.label}</div>
              <div class="pp__metaVals" data-pp-metavals>
                {col.values.map((v) => <div>{v}</div>)}
              </div>
            </div>
          ))}
        </div>
        {/* The summary is the one authored block with no length limit, and a
            long one lands as a wall of type beside the meta columns. It clamps
            to four lines and folds out; the button only appears when there is
            something folded, which only JS can know (see the script below). */}
        <div class="pp__desc" data-pp-summary data-open="false">
          <p class="pp__descText" set:html={renderInline(project.summary)} />
          <button class="pp__more" type="button" hidden>READ MORE</button>
        </div>
      </div>

      <div class="pp__galleryWrap">
        <section class="pp__gallery">
          {project.gallery.map((row) => (
            <div class={`pp__gRow pp__gRow--${row.layout}`}>
              {row.images.slice(0, GALLERY_SLOTS[row.layout] ?? row.images.length).map((src, i) => (
                <div class={`pp__g pp__g--slot${i + 1}`}>
                  <Media src={src} doc={row.docs?.[i] ?? null} alt="" loading="lazy" sizes={GALLERY_SIZES[row.layout] ?? '(max-width:480px) 90vw, 95vw'} />
                </div>
              ))}
            </div>
          ))}
        </section>
      </div>

      <section class="pp__stats">
        {project.stats.map((s) => (
          <div class="pp__stat">{s.label}<b>{s.value}</b></div>
        ))}
      </section>

      <section class="pp__credits">
        {project.credits.map((group) => (
          <>
            <div class="pp__creditsTitle">{group.title}</div>
            {group.entries.map((c) => (
              <div class="pp__credit">{c.title}
                <b>{c.url
                  ? <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                  : c.name}</b>
              </div>
            ))}
          </>
        ))}
      </section>

    </div>
  </div>

  {/* ---- Fixed chrome (outside the container-type frame; aligned to it by JS) ----
       The ProjectBar carries the write-up toggle (PROJECT INFO, [data-pp-toggle]),
       ALL WORK (the tile) and NEXT — replacing the old fixed toggle + the foot's
       prev/next + all-work block. project-page.ts still owns the open state. */}
  <ProjectBar next={{ href: `/work/${next.slug}`, title: next.title, tour: next.tour }} />

  <aside class="pp__aside" id="pp-writeup" data-pp-aside data-lenis-prevent aria-hidden="true">
    <div class="pp__notes" data-pp-notes>
      {/* Mobile-only swipe cue (top of the write-up) — tap or swipe back. */}
      <button class="pp__cue pp__cue--back" data-pp-cue="close" type="button">«««&nbsp;&nbsp;SWIPE FOR {CUE_WORK}&nbsp;&nbsp;«««</button>
      <div class="pp__notesLabel">[ PRODUCTION NOTES ]</div>
      <div class="pp__notesRich" data-cols={project.writeupColumns} set:html={renderWriteup(project.writeupBlocks, project.writeup)}></div>
      {/* Coverage. Rendered only when there is any — an empty [ PRESS ] label
          reads as something failing to load. Outside .pp__notesRich on purpose:
          that block is two-column on a long write-up, and the press list should
          not be pulled into the second column halfway down. */}
      {project.press.length > 0 && (
        <div class="pp__press">
          <div class="pp__notesLabel">[ PRESS ]</div>
          <ul class="pp__pressList">
            {project.press.map((item) => (
              <li class="pp__pressItem">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="pp__pressPub">{item.publication}</span>
                  {item.title && <span class="pp__pressTitle">{item.title}</span>}
                </a>
                {item.date && <span class="pp__pressDate">{item.date}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </aside>
</main>

<style>
  /* ============================ shell ============================ */
  .pp {
    position: relative;
    min-height: 100vh;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-bottom: 120px;
    color: var(--aoin-cool-white);
    /* Shared layout-transition timing (spec §0). --pp-edge / --pp-panel-w /
       --pp-*-top are written by JS; the fallbacks cover the pre-JS first paint. */
    --dl: 620ms cubic-bezier(0.16, 1, 0.3, 1);
    --pp-edge: 2.5%;
    --panel-delay: 0ms;
  }
  /* container-type lives HERE, not on .pp — so the fixed chrome (a .pp child,
     but NOT a frame descendant) stays viewport-fixed instead of scrolling. */
  .pp__frame {
    container-type: inline-size;
    width: 100%;
  }

  /* ============================ title ============================ */
  .pp__titleRow {
    position: relative;
    width: 95%;
    margin-left: 2.5%;
    box-sizing: content-box;
    padding-top: 12vh;
    padding-bottom: 50px;
    height: calc(clamp(46px, 9.4cqw, 148px) * 0.9);
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    transition: gap var(--dl);
    transition-delay: 168ms; /* stage 0, closing */
  }
  [data-expanded='true'] .pp__titleRow {
    justify-content: flex-start;
    gap: 0;
    transition-delay: 0ms; /* stage 0, opening */
  }
  .pp__title {
    margin: 0;
    flex: 0 1 auto;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: 0.9;
    letter-spacing: 0.01em;
    font-size: clamp(46px, 9.4cqw, 148px);
    /* The name and the tour share the row's bottom edge, but at 148px/0.9 the
       name's baseline sat ~15px above its box and the 21px mono tour's ~5px
       above its own — a visible stair-step between "MORGAN WALLEN" and "STILL
       THE PROBLEM TOUR". Trimming both boxes to cap-height/baseline makes the
       bottom edge THE baseline, so bottom-aligned means baseline-aligned at
       any pair of sizes. (Same trim .pp__metaCol uses; browsers without it
       keep the old bottom-alignment.) The trim itself is on the span below —
       the block that owns the line boxes. */
    /* The name scales with the reflow, on the same stage-0 timing as the hero.
       The fit script sets an explicit px target; this transitions between them. */
    transition: font-size var(--dl);
    transition-delay: 168ms; /* stage 0, closing */
  }
  [data-expanded='true'] .pp__title {
    transition-delay: 0ms; /* stage 0, opening */
  }
  .pp__title span {
    display: block;
    white-space: nowrap;
    max-width: 100%;
    text-box: trim-both cap alphabetic;
  }
  /* The fit script breaks the name across two lines rather than shrink it past
     a floor (see fit() in lib/project-page.ts). `balance` so the two lines come
     out even instead of a long line over an orphan. */
  [data-pp-lines='2'] .pp__title span {
    white-space: normal;
    text-wrap: balance;
  }
  [data-expanded='true'] .pp__title span {
    max-width: calc(49cqw - 24px);
  }
  .pp__tour {
    position: absolute;
    left: 49cqw;
    bottom: 50px;
    width: max-content;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: clamp(13px, 1.25cqw, 21px);
    line-height: 1;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-box: trim-both cap alphabetic; /* baseline = box bottom, paired with .pp__title */
    transform: translateX(calc(46cqw - 100%));
    transition: transform var(--dl);
    transition-delay: 168ms;
  }
  [data-expanded='true'] .pp__tour {
    transform: translateX(0);
    transition-delay: 0ms;
  }

  /* ============================ hero ============================ */
  .pp__hero {
    position: relative;
    width: 95%;
    margin-left: 2.5%;
    height: 82vh;
    min-height: 520px;
    overflow: hidden;
    border-radius: var(--hero-radius);
    transition: width var(--dl), height var(--dl);
    transition-delay: 168ms; /* stage 0 */
  }
  [data-expanded='true'] .pp__hero {
    width: 46.55%;
    height: 46vh;
    min-height: 300px;
    transition-delay: 0ms;
  }
  .pp__hero img,
  .pp__hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pp__heroScrim {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0; /* dial per bright hero (scrimOpacity prop) */
  }
  .pp__heroGrad {
    position: absolute;
    inset: 0;
    opacity: 0; /* protection gradient (gradientOpacity prop) */
    background: linear-gradient(180deg, #000 8.9%, transparent 49.2%, #000 86.1%);
  }

  /* ============================ content ============================ */
  .pp__content {
    width: 95%;
    margin: 0 auto;
  }

  /* ---- meta ---- */
  .pp__meta {
    margin-top: 44px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0;
    width: 100%;
    transition: width var(--dl), gap var(--dl);
    transition-delay: 112ms; /* stage 2, closing */
  }
  [data-expanded='true'] .pp__meta {
    flex-direction: column;
    gap: 28px;
    width: 49%;
    transition-delay: 110ms; /* stage 2, opening */
  }
  .pp__metaCols {
    width: 40%;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    transition: width var(--dl);
    transition-delay: 140ms; /* stage 1, closing */
  }
  [data-expanded='true'] .pp__metaCols {
    width: 100%;
    transition-delay: 55ms; /* stage 1, opening */
  }
  .pp__metaCol {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1.5;
    /* Trim the leading above the first line so the label caps sit at the box
       top — lines the subtitle caps up with the summary's cap height. */
    text-box: trim-both cap alphabetic;
  }
  .pp__metaLabel {
    color: var(--aoin-cool-white-45);
  }
  .pp__metaVals > div {
    /* An entry split across the column gap would read as two services. */
    break-inside: avoid;
  }
  /* A long SERVICES list is the one meta column that can run away with the
     block. Thirteen entries ran 441px deep beside a YEAR of 27px and a
     COLLABORATOR of 45px — the column stopped reading as one item in a row of
     three and became the row.

     The list now gets a ROW BUDGET instead of a column count. It flows into as
     many columns as the width actually affords (auto-fill, so 1 / 2 / 3 / 4
     falls out of the measurement rather than out of a breakpoint), and once
     the budget is spent the rest scrolls. Grid rather than `columns` on
     purpose: multi-column with a constrained height overflows SIDEWAYS — the
     box measures 1180px of scrollWidth and nothing scrolls down — whereas a
     row-flowed grid grows downward, which is the axis a scrollbar can take.

     206px is the measured width of the longest service name at 12px/0.14em
     ("Previsualization Suite"); min() lets a track fall below it rather than
     overflow when the column itself is narrower than one name. */
  .pp__metaCol[data-flow] {
    /* Take the width the other two columns leave, instead of only what the
       longest entry asks for. min-width:0 so it can also give width back. */
    flex: 1 1 auto;
    min-width: 0;
  }
  .pp__metaCol[data-flow] .pp__metaVals {
    --pp-meta-rows: 5;
    --pp-svc-col: 206px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--pp-svc-col)), 1fr));
    column-gap: 22px;
    row-gap: 0;
    max-height: calc(var(--pp-meta-rows) * 1.5em); /* line-height is 1.5 */
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none; /* the fade below is the affordance, not a bar */
  }
  .pp__metaCol[data-flow] .pp__metaVals::-webkit-scrollbar {
    display: none;
  }
  /* Cut the last visible line off softly, and ONLY when something is actually
     below it — a permanent fade would dim the final entry of a list that fits.
     [data-pp-more] is set from the script by measurement. */
  .pp__metaCol[data-flow] .pp__metaVals[data-pp-more] {
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 calc(100% - 18px), transparent 100%);
    mask-image: linear-gradient(180deg, #000 0, #000 calc(100% - 18px), transparent 100%);
  }

  /* The block widens to pay for those columns, out of the gutter between the
     meta and the summary — 263px of dead space at 1920 on the old 40%. It only
     widens where there is width to take: below this the meta block cannot grow
     without running into the summary, so the list stays narrow and scrolls. */
  @container (min-width: 1200px) {
    .pp__metaCols:has(.pp__metaCol[data-flow]) {
      width: 48%;
    }
  }
  @container (min-width: 1500px) {
    .pp__metaCols:has(.pp__metaCol[data-flow]) {
      width: max(48%, 740px);
    }
  }
  /* With the write-up open the meta block is down to 49% of the page, but it
     is 100% of that — enough for two or three tracks, so the grid keeps
     flowing. The budget tightens because the panel beside it is the thing
     being read. */
  [data-expanded='true'] .pp__metaCols:has(.pp__metaCol[data-flow]) {
    width: 100%;
  }
  [data-expanded='true'] .pp__metaCol[data-flow] .pp__metaVals {
    --pp-meta-rows: 4;
  }
  .pp__desc {
    width: 45%;
    margin: 0;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    font-size: clamp(18px, 1.5cqw, 32px);
    line-height: 1.25;
    text-transform: none; /* summary reads as authored (sentence case), not the site-wide uppercase */
    text-box: trim-both cap alphabetic;
    text-wrap: pretty;
    transition: width var(--dl), font-size var(--dl);
    transition-delay: 140ms; /* stage 1 */
  }
  /* There is no italic cut of Denim INK WD — the family ships Regular and
     Medium and nothing else — so an <em> would be browser-slanted, which on a
     display face reads as a mistake. Emphasis takes the treatment the write-up
     already gives <strong>: the real Medium cut, at full brightness. Getting
     true italics needs an italic binary from the foundry, not a CSS rule. */
  .pp__descText :global(em),
  .pp__descText :global(strong),
  .pp__notesRich :global(em) {
    font-style: normal;
    font-weight: var(--weight-headline);
    color: var(--aoin-cool-white);
  }
  .pp__descText {
    margin: 0;
    /* Four lines, then the fold — keep in step with CLAMP_LINES in the script.
       -webkit-line-clamp is the only form every engine here honours;
       `line-clamp` rides alongside it for the day that changes. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    /* Clipped in BOTH states, not just when folded: the closing animation
       shrinks the box while the text is still fully laid out inside it, and
       anything visible would spill over the gallery on the way down. */
    overflow: hidden;
  }
  /* Open is a BIGGER clamp, not no clamp. Unsetting it takes the element out
     of -webkit-box layout, and `text-box: trim-both` then trims differently —
     measured at 8.5px, which the eye catches as the copy jumping up the moment
     the fold finishes closing. Staying in the same layout mode costs nothing
     and moves nothing. */
  [data-pp-summary][data-open='true'] .pp__descText,
  /* Short enough not to be worth a button: it just runs. Set by measure(), so
     the default stays clamped and nothing flashes at full height first. */
  [data-pp-summary][data-fold='no'] .pp__descText {
    -webkit-line-clamp: 9999;
    line-clamp: 9999;
  }
  .pp__more {
    margin-top: 14px;
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    color: var(--aoin-cool-white-45);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 240ms var(--ease-brand), border-color 240ms var(--ease-brand);
  }
  .pp__more:hover {
    color: var(--aoin-cool-white);
    border-color: var(--aoin-cool-white);
  }
  .pp__more[hidden] {
    display: none;
  }
  [data-expanded='true'] .pp__desc {
    width: 100%;
    font-size: 20px;
    transition-delay: 55ms;
  }

  /* ---- gallery (arrangements) ---- */
  .pp__galleryWrap {
    display: block; /* the panel is fixed, so no flex row is needed here */
  }
  /* The gallery is now a vertical stack of authored rows; each row lays its
     own slots on the shared 12-col grid. */
  .pp__gallery {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 80px;
    margin-top: 72px;
    transition: width var(--dl), gap var(--dl);
    transition-delay: 84ms; /* stage 3, closing */
  }
  [data-expanded='true'] .pp__gallery {
    width: 49%;
    gap: 24px;
    transition-delay: 165ms; /* stage 3, opening */
  }
  .pp__gRow {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 80px;
    align-items: start;
    transition: gap var(--dl);
    transition-delay: 84ms;
  }
  [data-expanded='true'] .pp__gRow {
    gap: 24px;
    transition-delay: 165ms;
  }
  .pp__g {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }
  .pp__g img,
  .pp__g video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Layout presets — fixed aspect ratios per slot, keeping the page's rhythm.
     The two asymmetric splits mirror the old a/b and c/d tiles. */
  .pp__gRow--full .pp__g { grid-column: 1 / -1; aspect-ratio: 16 / 7; }
  /* The same full-width row at other heights, so an editor can match the row to
     the picture instead of the picture being cropped to the row. */
  .pp__gRow--full-16-9 .pp__g { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  .pp__gRow--full-2-1 .pp__g  { grid-column: 1 / -1; aspect-ratio: 2 / 1; }
  .pp__gRow--full-3-1 .pp__g  { grid-column: 1 / -1; aspect-ratio: 3 / 1; }
  /* 19/5 is 3.8:1; 27/4 is 6.75:1 — for LED-canvas panoramas. */
  .pp__gRow--full-19-5 .pp__g { grid-column: 1 / -1; aspect-ratio: 19 / 5; }
  .pp__gRow--full-27-4 .pp__g { grid-column: 1 / -1; aspect-ratio: 27 / 4; }
  .pp__gRow--two-up .pp__g { grid-column: span 6; aspect-ratio: 4 / 3; }
  .pp__gRow--split-8-4 .pp__g--slot1 { grid-column: 1 / span 8; aspect-ratio: 16 / 9; }
  .pp__gRow--split-8-4 .pp__g--slot2 { grid-column: 9 / span 4; align-self: end; aspect-ratio: 1 / 1; }
  .pp__gRow--split-5-7 .pp__g--slot1 { grid-column: 1 / span 5; aspect-ratio: 4 / 3; }
  .pp__gRow--split-5-7 .pp__g--slot2 { grid-column: 6 / span 7; align-self: end; aspect-ratio: 16 / 9; }
  .pp__gRow--three-up .pp__g { grid-column: span 4; aspect-ratio: 4 / 3; }

  /* ---- stats ---- */
  .pp__stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 12px;
    margin-top: 72px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--aoin-cool-white-45);
    transition: width var(--dl);
    transition-delay: 56ms; /* stage 4, closing */
  }
  [data-expanded='true'] .pp__stats {
    width: 49%;
    font-size: 10px; /* step change, NOT transitioned (only width is) */
    transition-delay: 220ms; /* stage 4, opening */
  }
  .pp__stat { grid-column: span 3; }
  .pp__stat b {
    display: block;
    font-weight: var(--weight-mono);
    color: var(--aoin-cool-white);
    margin-top: 8px;
    font-size: 2.4em;
    letter-spacing: 0.04em;
  }

  /* ---- credits ---- */
  .pp__credits {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 34px 12px;
    margin-top: 48px;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    font-size: 18px;
    letter-spacing: 0.04em;
    transition: width var(--dl);
    transition-delay: 28ms; /* stage 5, closing */
  }
  [data-expanded='true'] .pp__credits {
    width: 49%;
    font-size: 15px; /* step change, NOT transitioned */
    transition-delay: 275ms; /* stage 5, opening */
  }
  .pp__creditsTitle {
    grid-column: 1 / -1;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: 2em;
    letter-spacing: 0.01em; /* match the big Denim titles (artist name, NEXT PROJECT) */
    margin-bottom: 2px;
  }
  .pp__credit {
    grid-column: span 3;
    color: var(--aoin-cool-white-45);
    font-size: 14px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
  }
  .pp__credit b {
    display: block;
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    color: var(--aoin-cool-white);
    margin-top: 8px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    word-break: break-word;
  }
  .pp__credit a {
    color: inherit;
    text-decoration: none;
    text-transform: uppercase; /* visible text only — href keeps the real handle */
    border-bottom: 1px solid rgba(217, 225, 234, 0.28);
  }

  /* ============================ fixed chrome (write-up aside) ============================
     The action controls (write-up toggle, all-work, next) now live in the
     ProjectBar; only the write-up panel remains as fixed chrome here. */
  .pp__aside {
    position: fixed;
    top: var(--pp-aside-top, 148px);
    right: var(--pp-edge);
    width: 0;
    max-height: var(--pp-aside-maxh, calc(100vh - 148px - 92px));
    /* Height-capped, so a long write-up has to scroll inside the panel. overflow-x
       stays hidden to clip the content while the width animates open; overscroll
       keeps the wheel from chaining to the page behind once the panel bottoms out.
       Lenis owns the wheel site-wide, so the aside also carries data-lenis-prevent
       (see the markup) — without it Lenis eats the gesture and the panel never moves. */
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-sizing: border-box;
    z-index: 15;
    pointer-events: none;
    opacity: 0;
    transition:
      width 500ms cubic-bezier(0.16, 1, 0.3, 1) var(--panel-delay),
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1) var(--panel-delay);
  }
  [data-expanded='true'] .pp__aside {
    width: var(--pp-panel-w, 46vw);
    opacity: 1;
    pointer-events: auto;
  }
  .pp__notes {
    width: var(--pp-panel-w, 46vw);
    box-sizing: border-box;
    padding-right: 18px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .pp__notesLabel {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--aoin-cool-white-45);
  }
  /* ---- press ----
     Sits under the write-up in the panel and borrows the credits block's
     shape — mono label over a Denim line — so the panel reads as one column of
     the same material rather than two unrelated lists. */
  .pp__press {
    display: flex;
    flex-direction: column;
    gap: 16px;
    /* The write-up's own gap is 24px; press is a different section, not another
       paragraph, so it sits further off and takes a rule. */
    margin-top: 20px;
    padding-top: 28px;
    border-top: 1px solid rgba(217, 225, 234, 0.16);
  }
  .pp__pressList {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pp__pressItem {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .pp__pressItem a {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .pp__pressPub {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--aoin-cool-white-45);
    text-transform: uppercase;
  }
  .pp__pressTitle {
    font-family: var(--font-headline);
    font-weight: var(--weight-body);
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--aoin-cool-white);
    text-transform: none; /* a headline reads as written, like the write-up */
    /* The underline is on the headline alone, so the masthead above it stays a
       label rather than looking like part of the link target. */
    border-bottom: 1px solid rgba(217, 225, 234, 0.28);
    /* Only as wide as the words, so the rule stops with the text. */
    align-self: flex-start;
    transition: border-color 220ms ease, color 220ms ease;
  }
  .pp__pressItem a:hover .pp__pressTitle {
    border-bottom-color: var(--aoin-cool-white);
  }
  .pp__pressDate {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--aoin-cool-white-45);
    white-space: nowrap;
  }

  /* Rendered write-up (rich text), set in Denim; the first paragraph reads as
     the lede. NB: the content is injected via set:html, so Astro's scoped
     selectors can't tag it — set the base type on the (scoped) container so the
     injected children inherit it, and use :global() for the per-element rules. */
  .pp__notesRich {
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* Opt out of the global uppercase — the write-up reads as authored. */
    text-transform: none;
    /* Base prose type — inherited by the injected content (Denim, not serif). */
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    font-size: 15px;
    line-height: 1.7;
    color: var(--aoin-cool-white-45);
  }
  .pp__notesRich :global(p) {
    margin: 0;
  }
  .pp__notesRich :global(ul),
  .pp__notesRich :global(ol) {
    margin: 0;
    padding-left: 1.2em;
  }
  .pp__notesRich :global(h1),
  .pp__notesRich :global(h2),
  .pp__notesRich :global(h3),
  .pp__notesRich :global(h4),
  .pp__notesRich :global(h5),
  .pp__notesRich :global(h6) {
    margin: 4px 0 0;
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--aoin-cool-white);
  }
  .pp__notesRich :global(strong) {
    color: var(--aoin-cool-white);
    font-weight: var(--weight-headline);
  }
  .pp__notesRich :global(a) {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(217, 225, 234, 0.28);
  }
  .pp__notesRich :global(p:first-of-type) {
    font-weight: var(--weight-body);
    font-size: 20px;
    line-height: 1.45;
    color: var(--aoin-cool-white);
    text-wrap: pretty;
  }

  /* ---- two-column flow (writeupColumns on the project) ----
     Multi-column, not grid: the copy has to FLOW between the columns. A grid
     would make the editor decide, per block, which side each paragraph lands
     on. The `300px 2` shorthand caps it at two columns and drops back to one
     the moment they'd be narrower than 300px — which is what happens on the
     mobile panel (100% wide) and on a small laptop, so no breakpoint needed. */
  .pp__notesRich[data-cols='2'] {
    display: block;
    columns: 300px 2;
    column-gap: 34px;
  }
  .pp__notesRich[data-cols='2'] :global(> *) {
    /* the flex gap is gone with display:block — space the blocks by margin */
    margin: 0 0 20px;
    /* a paragraph broken across the column gap reads as two paragraphs */
    break-inside: avoid;
  }
  .pp__notesRich[data-cols='2'] :global(p:first-of-type) {
    /* the lede runs the full measure; the body breaks into columns under it */
    column-span: all;
    margin-bottom: 26px;
  }

  /* ---- inline media (an `upload` node in the write-up) ----
     Serialized by lib/richtext.ts as <figure class="rt-fig rt-fig--full|half">.
     Unlike the gallery these are NOT cropped to a fixed row: the figure takes
     the media's own aspect ratio, because in prose the picture is an aside, not
     a slot to be filled. */
  .pp__notesRich :global(.rt-fig) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    break-inside: avoid;
  }
  .pp__notesRich :global(.rt-fig img),
  .pp__notesRich :global(.rt-fig video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px; /* matches the gallery tiles */
  }
  .pp__notesRich :global(.rt-fig figcaption) {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--aoin-cool-white-35);
  }
  /* FULL breaks out across both columns; ONE COLUMN stays in the text flow.
     With one column there is nothing to span, so ONE COLUMN just renders
     narrower — the setting still means something either way. */
  .pp__notesRich[data-cols='2'] :global(.rt-fig--full) {
    column-span: all;
  }
  .pp__notesRich[data-cols='1'] :global(.rt-fig--half) {
    width: 62%;
  }

  /* ---- the rest of the toolbar ---- */
  .pp__notesRich :global(blockquote) {
    margin: 0;
    padding-left: 14px;
    border-left: 1px solid rgba(217, 225, 234, 0.28);
    color: var(--aoin-cool-white);
  }
  .pp__notesRich :global(.rt-indent) {
    padding-left: 1.4em;
  }
  .pp__notesRich :global(s) {
    opacity: 0.6;
  }
  .pp__notesRich :global(code) {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 0.92em;
  }

  /* ---- mobile swipe cue (desktop: hidden; shown in the mobile block) ---- */
  .pp__cue {
    display: none;
  }
  /* A soft black gradient sweeps through the text to denote the swipe
     direction — forward (»») sweeps left→right, back («») sweeps right→left. */
  @keyframes pp-cue-sweep-r {
    from { transform: translateX(-110%); }
    to { transform: translateX(110%); }
  }
  @keyframes pp-cue-sweep-l {
    from { transform: translateX(110%); }
    to { transform: translateX(-110%); }
  }

  /* ============================ reduced motion ============================ */
  @media (prefers-reduced-motion: reduce) {
    .pp * {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ============================ mobile ============================
     Phones can't do the desktop 2-up compress, so the write-up is a full-screen
     panel you swipe (or tap the bottom button) to: the project content slides
     off-left and the notes slide in from the right (see project-page.ts). */
  @media (max-width: 720px) {
    :global(html) {
      overflow-x: hidden; /* contain the off-screen slide panels */
    }
    .pp {
      padding-bottom: 128px;
    }
    .pp__titleRow {
      display: block;
      height: auto;
      width: 90%;
      margin-left: 5%;
      padding-top: 6px; /* the swipe cue above provides the top clearance now */
      padding-bottom: 28px;
    }

    /* The swipe cue — a small mono line with a black gradient sweeping through
       it to hint the direction. Tappable, and the whole page is swipeable. */
    .pp__cue {
      display: block;
      position: relative;
      overflow: hidden;
      width: max-content;
      max-width: 90%;
      margin: 0 auto;
      padding: 5px 2px;
      background: none;
      border: 0;
      cursor: pointer;
      font-family: var(--font-mono);
      font-weight: var(--weight-mono);
      font-size: 11px;
      letter-spacing: 0.22em;
      color: var(--aoin-cool-white);
      white-space: nowrap;
    }
    .pp__cue::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, transparent 32%, #000 50%, transparent 68%);
    }
    .pp__cue--fwd {
      margin-top: 13vh; /* clears the fixed nav */
      margin-bottom: 22px;
    }
    .pp__cue--fwd::after {
      animation: pp-cue-sweep-r 2.6s linear infinite;
    }
    .pp__cue--back::after {
      animation: pp-cue-sweep-l 2.6s linear infinite;
    }
    .pp__title {
      font-size: clamp(40px, 15vw, 88px);
    }
    .pp__title span {
      max-width: 100% !important;
    }
    .pp__tour {
      position: static;
      transform: none !important;
      width: 100%;
      margin-top: 12px;
      text-align: center; /* centre the tour under the artist name */
    }
    .pp__hero {
      width: 90%;
      margin-left: 5%;
      height: 62vh;
      min-height: 360px;
    }
    .pp__content {
      width: 90%;
    }
    .pp__meta {
      flex-direction: column;
      gap: 24px;
    }
    .pp__metaCols,
    .pp__desc {
      width: 100% !important;
    }
    /* A long SERVICES list was a sliver beside YEAR and COLLABORATOR, every
       entry broken over two or three lines. It gets its own row instead: the
       meta row wraps, the flowed column drops under the other two at full
       width and runs in TWO columns, and it grows as tall as it needs — the
       row budget and the scroll are desktop measures for a block with a
       summary beside it; on a phone the page simply gets longer. YEAR and
       COLLABORATOR pack left on the first row and may shrink (min-width:0),
       so a long collaborator wraps in place rather than taking a row of its
       own. Short lists keep the three-across layout. */
    .pp__metaCols:has(.pp__metaCol[data-flow]) {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 24px 36px;
    }
    .pp__metaCols:has(.pp__metaCol[data-flow]) .pp__metaCol:not([data-flow]) {
      flex: 0 1 auto;
      min-width: 0;
    }
    .pp__metaCol[data-flow] {
      flex: 1 1 100%;
    }
    .pp__metaCol[data-flow] .pp__metaVals {
