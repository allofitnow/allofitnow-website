---
/* The four capability slots. Order is fixed: index 0 is the selected service after a pick,
   indices 1-3 become that service's subcategories. All sizing is computed in fitSlots(). */
---
<div data-bar="" style="position:absolute;left:48px;right:48px;top:52vh;z-index:30;display:flex;justify-content:space-between;align-items:center;font-family:'SN Ja Mono',ui-monospace,Menlo,monospace;font-weight:300;font-size:22.5px;letter-spacing:.22em;transition:top 900ms cubic-bezier(.16,1,.3,1)">
<button type="button" data-slot="" data-i="0" style="font:inherit;letter-spacing:inherit;border:0;background:none;padding:0;color:rgba(217,225,234,0.45);cursor:pointer;transition:color 300ms ease;white-space:nowrap">REAL-TIME CONTENT</button>
<button type="button" data-slot="" data-i="1" style="font:inherit;letter-spacing:inherit;border:0;background:none;padding:0;color:rgba(217,225,234,0.45);cursor:pointer;transition:color 300ms ease;white-space:nowrap">SCREENS PRODUCTION</button>
<button type="button" data-slot="" data-i="2" style="font:inherit;letter-spacing:inherit;border:0;background:none;padding:0;color:rgba(217,225,234,0.45);cursor:pointer;transition:color 300ms ease;white-space:nowrap">MIXED REALITY</button>
<button type="button" data-slot="" data-i="3" style="font:inherit;letter-spacing:inherit;border:0;background:none;padding:0;color:rgba(217,225,234,0.45);cursor:pointer;transition:color 300ms ease;white-space:nowrap">EQUIPMENT RENTAL</button>
</div>
