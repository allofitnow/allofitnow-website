---
/* Panel 1 — SCREENS PRODUCTION.
   Verbatim from the design. Do not change gallery order, [data-sq]/[data-par] nesting, or the
   inline percentages on [data-par]: the parallax cap is derived from that overhang. */
---
<div data-panel="" data-i="1" style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;gap:clamp(14px,3vh,34px);opacity:0;min-height:0">
<div data-imgs="" style="flex:1 1 64%;min-height:clamp(110px,26vh,340px);display:flex;gap:20px;align-items:center;justify-content:center;will-change:transform">
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/01.png" alt="Screens production" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/02.png" alt="Technical direction" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/03.png" alt="Media servers" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/04.png" alt="Show integration" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/05.png" alt="Screens producing" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
<div data-sq="" style="flex:0 0 auto;min-width:0;aspect-ratio:16/9;overflow:hidden;background:#0d1116;position:relative"><img data-par="" src="/img/services/screens/06.png" alt="Programming" style="position:absolute;top:-40%;left:-40%;width:180%;height:180%;object-fit:cover;display:block;will-change:transform"></div>
</div>
<div style="display:grid;grid-template-columns:1fr auto;gap:64px;align-items:end">
<p data-copy="" style="margin:0;columns:2;column-gap:48px;font-size:clamp(12px,1.6vh,19px);line-height:1.45;color:rgba(217,225,234,0.86);text-wrap:pretty">We offer a comprehensive range of Screens producing, technical direction, and media server programming solutions that ensure your event runs smoothly and leaves a lasting impression on your audience.</p>
<div style="display:flex;flex-direction:column;width:max-content">
<button type="button" data-other="" data-target="0" style="font-family:'Denim INK WD',sans-serif;font-weight:500;font-size:15px;letter-spacing:.02em;text-align:left;border:0;border-top:1px solid rgba(217,225,234,0.28);background:none;color:rgba(217,225,234,0.45);padding:9px 100px 9px 0;cursor:pointer;transition:color 300ms ease">REAL-TIME CONTENT</button>
<button type="button" data-other="" data-target="1" style="font-family:'Denim INK WD',sans-serif;font-weight:500;font-size:15px;letter-spacing:.02em;text-align:left;border:0;border-top:1px solid rgba(217,225,234,0.28);background:none;color:rgba(217,225,234,0.45);padding:9px 100px 9px 0;cursor:pointer;transition:color 300ms ease">SCREENS PRODUCTION</button>
<button type="button" data-other="" data-target="2" style="font-family:'Denim INK WD',sans-serif;font-weight:500;font-size:15px;letter-spacing:.02em;text-align:left;border:0;border-top:1px solid rgba(217,225,234,0.28);background:none;color:rgba(217,225,234,0.45);padding:9px 100px 9px 0;cursor:pointer;transition:color 300ms ease">MIXED REALITY</button>
<button type="button" data-other="" data-target="3" style="font-family:'Denim INK WD',sans-serif;font-weight:500;font-size:15px;letter-spacing:.02em;text-align:left;border:0;border-top:1px solid rgba(217,225,234,0.28);border-bottom:1px solid rgba(217,225,234,0.28);background:none;color:rgba(217,225,234,0.45);padding:9px 100px 9px 0;cursor:pointer;transition:color 300ms ease">EQUIPMENT RENTAL</button>
</div>
</div>
</div>
