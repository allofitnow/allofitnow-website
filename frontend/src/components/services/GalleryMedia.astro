---
/* One gallery still — an <img>, or a silently-looping <video> when the CMS media is a video
   (mimeType video/*). Both carry the `.media` class + the same data-* so the scrub effects
   (buildRealtime/buildScreens select `.media`), the click-to-project nav, and the hovercard
   treat them identically. Video plays as a moving still: autoplay + muted + loop + playsinline.
   #58: with a populated doc, the img carries data-lazysrcset — the scroll engine copies it
   into srcset at load time (same moment as data-lazysrc -> src), so the browser picks the
   right ladder rung for the slot instead of the full-res original. URLs derive from
   filename (SSOT); video docs fall back to plain data-lazysrc (no rungs). */
import { appendMasterRung, buildSrcset, videoPosterHref, videoRungs } from '@/lib/media';
import type { GalleryItem } from '../../data/services';

interface Props {
  item: GalleryItem;
  /** CSS aspect-ratio string (e.g. '16 / 9'). */
  ar: string;
}
const { item, ar } = Astro.props;
const { src, href, slug, title, tour, caps, video, ar: itemAr } = item;
// A "full width" still carries its own natural aspect (item.ar); otherwise use
// the section default passed in (16:9).
const finalAr = itemAr || ar;
const parts = item.doc ? buildSrcset(item.doc) : null;
const lazySrc = parts?.src || src;
const lazySrcset = parts?.srcset || undefined;
// #103: video rendition ladder — a wired video doc (sizes w1280/w854) carries
// data-rungs + poster; services-effects.js loadMedia() picks the rung at
// section entry (same moment it swaps data-lazysrc), so the deferral contract
// is unchanged and only the chosen rendition hits the wire. The master tops
// the ladder (#99 contract) and also stays in data-lazysrc as the engine's
// fallback of record.
const vRungs = video && item.doc ? videoRungs(item.doc) : [];
if (vRungs.length) appendMasterRung(vRungs, lazySrc, item.doc?.width);
const vPoster = vRungs.length > 0 && item.doc ? videoPosterHref(item.doc) : null;
---
{/* Media is DEFERRED: the real URL lives in data-lazysrc, not src, so nothing loads
    until the scroll engine (services-effects.js) reaches this still's section and swaps
    it in. Without this every section's video autoplays at page load (~276MB up front).
    Videos: muted/loop/playsinline but NO autoplay — the engine calls .play() on entry. */}
{video ? (
  <video
    class="media"
    style={`aspect-ratio:${finalAr}`}
    data-lazymedia
    data-lazysrc={lazySrc}
    data-master-src={vRungs.length ? lazySrc : undefined}
    data-rungs={vRungs.length ? JSON.stringify(vRungs) : undefined}
    poster={vPoster || undefined}
    muted
    loop
    playsinline
    preload="none"
    data-href={href}
    data-slug={slug}
    data-title={title}
    data-tour={tour}
    data-caps={caps}
  ></video>
) : (
  <img
    class="media"
    style={`aspect-ratio:${finalAr}`}
    data-lazymedia
    data-lazysrc={lazySrc}
    data-lazysrcset={lazySrcset}
    loading="lazy"
    decoding="async"
    sizes="(max-width:480px) 65vw, 33vw"
    alt=""
    data-href={href}
    data-slug={slug}
    data-title={title}
    data-tour={tour}
    data-caps={caps}
  />
)}
