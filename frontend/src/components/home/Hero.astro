---
import { hero, getReel } from '@/data/home';
const reel = await getReel();
// A self-hosted file plays in a <video> cover-cropped by CSS; a Vimeo link goes through the
// background player (background=1 is what strips the chrome). h= only belongs on the URL for
// an unlisted video — sending an empty one makes Vimeo reject the embed.
const isUpload = reel.source === 'upload';
const reelSrc = `https://player.vimeo.com/video/${reel.vimeoId}?${reel.hash ? `h=${reel.hash}&` : ''}background=1&autoplay=1&loop=1&muted=1&autopause=0&dnt=1`;
const cueWord = (w: string) => w.split('');
---

<div class="hero" data-ref="heroWrap" data-screen-label="Hero">
  <div class="sticky">
    <div class="word w-all" data-ref="wAll">{hero.words[0]}</div>
    <div class="word w-of" data-ref="wOf">{hero.words[1]}</div>
    <div class="word w-it" data-ref="wIt">{hero.words[2]}</div>
    <div class="word w-now" data-ref="wNow">{hero.words[3]}</div>

    <div class="mask" data-ref="mask">
      <div class="intro-icon" data-ref="introIcon">
        <img class="icon" data-ref="icon" src="/assets/aoin-icon.svg" alt="AOIN icon" />
      </div>
      <div class="box" data-ref="box">
        <div class="reel-frame" data-ref="reelFrame">
          {
            isUpload ? (
              <video
                data-ref="reelVideo"
                src={reel.src}
                poster={reel.poster || undefined}
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                aria-label="AOIN reel"></video>
            ) : (
              <iframe
                data-ref="reelIframe"
                src={reelSrc}
                allow="autoplay; fullscreen"
                title="AOIN reel"></iframe>
            )
          }
        </div>
      </div>
    </div>

    <div class="cue" data-ref="cue" data-screen-label="Scroll cue">
      <div class="cue-row">
        <span class="grp" data-g="1" data-br="-1"
          ><span data-gi="1"><span data-l="1" data-b="1">[</span></span></span
        >
        <span class="sp"></span>
        <span class="grp" data-g="1"
          ><span data-gi="1">{cueWord('SCROLL').map((c) => <span data-l="1">{c}</span>)}</span></span
        >
        <span class="sp"></span>
        <span class="grp" data-g="1"
          ><span data-gi="1">{cueWord('DOWN').map((c) => <span data-l="1">{c}</span>)}</span></span
        >
        <span class="sp"></span>
        <span class="grp" data-g="1" data-br="1"
          ><span data-gi="1"><span data-l="1" data-b="1">]</span></span></span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    height: 300svh; /* controller overrides to pinViewports × 100svh */
  }
  .sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .word {
    position: absolute;
    z-index: 4;
    opacity: 0;
    color: var(--aoin-cool-white);
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: clamp(44px, 6.2vw, 112px);
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .w-all {
    top: 40px;
    left: 48px;
  }
  .w-of {
    top: 40px;
    right: 48px;
  }
  .w-it {
    bottom: 44px;
    left: 48px;
  }
  .w-now {
    bottom: 44px;
    right: 48px;
  }

  .mask {
    position: absolute;
    overflow: hidden;
    z-index: 3;
  }
  .intro-icon {
    position: absolute;
    inset: 0;
    transform: scale(0);
  }
  .icon {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .box {
    position: absolute;
    inset: 0;
    background: var(--aoin-cool-white);
    overflow: hidden;
    transform: translateY(101%);
  }
  .reel-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
  }
  .reel-frame iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
  }
  /* The iframe is cover-cropped in JS (controller sizeReel measures the frame and sizes a
     16:9 player to overflow it) because an iframe has no intrinsic aspect to fit. A real
     video does, so object-fit does the same job here — and sizeReel no-ops, since it bails
     when there is no [data-ref="reelIframe"] to size. */
  .reel-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .cue {
    position: absolute;
    /* The box is the LETTERING, not the full width, and that is what makes the
       desaturation invisible: `backdrop-filter` filters the element's own box,
       so a full-width cue put a grey band across the film. Hugging the type
       confines it to the glyphs, where the difference blend covers it anyway. */
    left: 50%;
    transform: translateX(-50%);
    bottom: 38px;
    z-index: 6;
    /* On `.cue`, NOT on the row inside it. `z-index` here makes `.cue` a
       stacking context, and a stacking context isolates its DESCENDANTS — so a
       blend on the row blended against nothing and rendered flat white, which
       is precisely the case this was meant to fix (white lettering vanishing on
       a white frame). An element's own stacking context does not isolate the
       element itself, so the blend belongs at this level, where it reaches the
       reel sitting below in `.sticky`. */
    /* Both on the same element, and they compose: `backdrop-filter` builds a
       filtered backdrop, then `mix-blend-mode` blends against THAT. So the film
       is desaturated first and the type differences against grey — the result
       is only ever black or white, never the cyan that differencing raw colour
       gives (white type over a gold frame came back blue).

       It must sit here rather than on the row inside: `z-index` makes `.cue` a
       stacking context, and a stacking context isolates its DESCENDANTS, so the
       same rule one level down blended against nothing and rendered flat white
       — failing on exactly the bright frames it was added for. An element's own
       stacking context does not isolate the element itself. */
    backdrop-filter: grayscale(1);
    -webkit-backdrop-filter: grayscale(1);
    mix-blend-mode: difference;
    display: flex;
    justify-content: center;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    color: var(--aoin-cool-white);
    opacity: 0;
  }
  .cue-row {
    display: flex;
    align-items: flex-end;
  }
  .cue .grp {
    display: inline-block;
    overflow: hidden;
  }
  .cue [data-br] {
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cue [data-gi] {
    display: inline-block;
    white-space: nowrap;
    transform: translateY(110%);
  }
  .cue [data-l] {
    display: inline-block;
  }
  .cue .sp {
    display: inline-block;
    width: 1.1em;
  }
</style>
