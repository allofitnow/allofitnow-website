---
import { clients } from '@/data/home';

// Broken-measure row builder (from the component's AOIN_CLIENTS_DATA notes).
// Geometry is data-driven so the roster can change freely — edit data/home.ts.
const rowCounts = [3, 2, 3];
const rowGeometry: [number, number][] = [
  [100, 0],
  [70, 16],
  [84, 8],
  [100, 0],
  [62, 0],
  [78, 22],
];
const wordOffsets = [0, -1, 2, -3];
const shiftEm = 2.4;
const FIG = ' '; // figure space — justification leaves it tight

interface Word {
  text: string;
  dx: string;
  cls: string;
}
interface Row {
  width: number;
  ml: number;
  words: Word[];
}

const rows: Row[] = [];
let i = 0,
  k = 0,
  w = 0;
while (i < clients.length) {
  const count = rowCounts[k % rowCounts.length];
  const [width, ml] = rowGeometry[k % rowGeometry.length];
  const words: Word[] = [];
  for (const name of clients.slice(i, i + count)) {
    const dx = (wordOffsets[(w * 3 + k) % 4] * shiftEm).toFixed(2);
    const cls = 'aoin-w' + ((w * 7 + k * 3) % 4); // stable shuffle — variety is the point
    words.push({ text: name.replace(/ /g, FIG), dx, cls });
    w++;
  }
  rows.push({ width, ml, words });
  i += count;
  k++;
}
---

<section class="aoin-clients" data-screen-label="Clients">
  <div class="aoin-meta">
    <span>selected clients</span>
    <span>{clients.length} / estd. 2014</span>
  </div>

  {
    rows.map((row) => (
      <p class="aoin-line" style={`width:${row.width}%;margin-left:${row.ml}%`}>
        {row.words.map((word, j) => (
          <>
            <span class={`aoin-word ${word.cls}`} style={`--dx:${word.dx}em`}>
              {word.text}
            </span>
            {j < row.words.length - 1 && <span>{' '}</span>}
          </>
        ))}
      </p>
    ))
  }
</section>

<style>
  .aoin-clients {
    --lead: 2.7; /* 2x — more scroll distance per row so the settle/fade reads */
    --gap: 0.34em;
    --size: clamp(11px, 1.3cqw, 26px);
    container-type: inline-size;
    /* cap + centre on ultrawide (also stabilises the cqw-based sizing there) */
    max-width: var(--content-max);
    margin-inline: auto;
    /* transparent — the fixed film grain shows through, like the other sections */
    color: var(--aoin-cool-white);
    /* small bottom pad — the footer brings its own 110px top, and the 2.7 leading
       already leaves space under the last row */
    padding: 150px 48px 40px;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    /* the settle animation slides words in from a horizontal offset; clip the
       transient overhang so a narrow screen never gets a sideways scrollbar */
    overflow-x: clip;
  }
  .aoin-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px clamp(20px, 3cqw, 60px);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: clamp(11px, 0.9cqw, 13px);
    letter-spacing: clamp(0.14em, 0.3cqw, 0.3em);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 56px;
  }
  .aoin-line {
    margin: 0 0 var(--gap) 0;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: var(--size);
    line-height: var(--lead);
    text-align: justify;
    text-align-last: justify;
    word-spacing: 0.06em;
  }
  /* scroll-driven: horizontal settle (eased) + fade (linear), as two animations */
  @keyframes aoin-shift {
    from {
      transform: translateX(var(--dx));
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes aoin-f0 {
    0% { opacity: 0; }
    22% { opacity: 1; }
    74% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f1 {
    0% { opacity: 0; }
    30% { opacity: 1; }
    88% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f2 {
    0% { opacity: 0; }
    16% { opacity: 1; }
    64% { opacity: 1; }
    92% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f3 {
    0% { opacity: 0; }
    38% { opacity: 1; }
    80% { opacity: 1; }
    96% { opacity: 0; }
    100% { opacity: 0; }
  }
  .aoin-word {
    display: inline-block;
    animation-duration: 1s, 1s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), linear;
    animation-fill-mode: both, both;
    animation-timeline: view(), view();
  }
  .aoin-w0 {
    animation-name: aoin-shift, aoin-f0;
    animation-range: cover 0% cover 56%, cover 0% cover 100%;
  }
  .aoin-w1 {
    animation-name: aoin-shift, aoin-f1;
    animation-range: cover 0% cover 72%, cover 0% cover 100%;
  }
  .aoin-w2 {
    animation-name: aoin-shift, aoin-f2;
    animation-range: cover 0% cover 48%, cover 0% cover 100%;
  }
  .aoin-w3 {
    animation-name: aoin-shift, aoin-f3;
    animation-range: cover 0% cover 64%, cover 0% cover 100%;
  }
  @container (max-width: 640px) {
    .aoin-line {
      width: 100% !important;
      margin-left: 0 !important;
    }
  }
  /* On phones the nav rail sits at 20px — match it so the names span the same
     width instead of being boxed in tighter than the chrome. */
  @media (max-width: 720px) {
    .aoin-clients {
      padding: 110px 20px 40px;
    }
  }
  /* Scroll-driven timelines aren't universal (older iOS Safari). Without them the
     fade would fall back to a time-based run that ends at opacity 0 and the names
     disappear — so if view() isn't supported, just show them statically. */
  @supports not (animation-timeline: view()) {
    .aoin-word {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
  /* JS fallback (the script below adds .js-reveal only when view() timelines are
     unsupported — e.g. older iOS Safari): reveal each name with the same settle +
     fade as it scrolls into view, instead of leaving them static. */
  .aoin-clients.js-reveal .aoin-word {
    opacity: 0;
    transform: translateX(var(--dx));
    transition:
      opacity 0.7s linear,
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .aoin-clients.js-reveal .aoin-word.in {
    opacity: 1;
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .aoin-word {
      animation: none !important;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations (e.g. older iOS
  // Safari): reveal each client name with the same settle + fade as it scrolls
  // into view. Browsers that support `animation-timeline: view()` use the CSS
  // path above and skip this; reduced-motion users keep the static names.
  (() => {
    const section = document.querySelector<HTMLElement>('.aoin-clients');
    if (!section) return;
    if (CSS.supports('animation-timeline', 'view()')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    section.querySelectorAll<HTMLElement>('.aoin-word').forEach((w) => io.observe(w));
  })();
</script>
