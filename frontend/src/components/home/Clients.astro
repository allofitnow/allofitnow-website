---
import { clients } from '@/data/home';

// Broken-measure row builder (from the component's AOIN_CLIENTS_DATA notes).
// Geometry is data-driven so the roster can change freely — edit data/home.ts.
const rowCounts = [3, 2, 3];
const rowGeometry: [number, number][] = [
  [100, 0],
  [70, 16],
  [84, 8],
  [100, 0],
  [62, 0],
  [78, 22],
];
const wordOffsets = [0, -1, 2, -3];
const shiftEm = 2.4;
const FIG = ' '; // figure space — justification leaves it tight

interface Word {
  text: string;
  dx: string;
  cls: string;
}
interface Row {
  width: number;
  ml: number;
  words: Word[];
}

const rows: Row[] = [];
let i = 0,
  k = 0,
  w = 0;
while (i < clients.length) {
  const count = rowCounts[k % rowCounts.length];
  const [width, ml] = rowGeometry[k % rowGeometry.length];
  const words: Word[] = [];
  for (const name of clients.slice(i, i + count)) {
    const dx = (wordOffsets[(w * 3 + k) % 4] * shiftEm).toFixed(2);
    const cls = 'aoin-w' + ((w * 7 + k * 3) % 4); // stable shuffle — variety is the point
    words.push({ text: name.replace(/ /g, FIG), dx, cls });
    w++;
  }
  rows.push({ width, ml, words });
  i += count;
  k++;
}
---

<section class="aoin-clients" data-screen-label="Clients">
  <div class="aoin-meta">
    <span>selected clients</span>
    <span>estd. 2014</span>
  </div>

  {
    rows.map((row) => (
      <p class="aoin-line" style={`width:${row.width}%;margin-left:${row.ml}%`}>
        {row.words.map((word, j) => (
          <>
            <span class={`aoin-word ${word.cls}`} style={`--dx:${word.dx}em`}>
              {word.text}
            </span>
            {j < row.words.length - 1 && <span>{' '}</span>}
          </>
        ))}
      </p>
    ))
  }
</section>

<style>
  .aoin-clients {
    --lead: 2.7; /* 2x — more scroll distance per row so the settle/fade reads */
    --gap: 0.34em;
    --size: clamp(11px, 1.3cqw, 26px);
    container-type: inline-size;
    /* cap + centre on ultrawide (also stabilises the cqw-based sizing there) */
    max-width: var(--content-max);
    margin-inline: auto;
    /* transparent — the fixed film grain shows through, like the other sections */
    color: var(--aoin-cool-white);
    /* small bottom pad — the footer brings its own 110px top, and the 2.7 leading
       already leaves space under the last row */
    padding: 150px 48px 40px;
    box-sizing: border-box;
    position: relative;
    z-index: 1;
    /* the settle animation slides words in from a horizontal offset; clip the
       transient overhang so a narrow screen never gets a sideways scrollbar */
    overflow-x: clip;
  }
  .aoin-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px clamp(20px, 3cqw, 60px);
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: clamp(11px, 0.9cqw, 13px);
    letter-spacing: clamp(0.14em, 0.3cqw, 0.3em);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 56px;
  }
  .aoin-line {
    margin: 0 0 var(--gap) 0;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: var(--size);
    line-height: var(--lead);
    text-align: justify;
    text-align-last: justify;
    word-spacing: 0.06em;
  }
  /* scroll-driven: horizontal settle (eased) + fade (linear), as two animations */
  @keyframes aoin-shift {
    from {
      transform: translateX(var(--dx));
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes aoin-f0 {
    0% { opacity: 0; }
    22% { opacity: 1; }
    74% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f1 {
    0% { opacity: 0; }
    30% { opacity: 1; }
    88% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f2 {
    0% { opacity: 0; }
    16% { opacity: 1; }
    64% { opacity: 1; }
    92% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes aoin-f3 {
    0% { opacity: 0; }
    38% { opacity: 1; }
    80% { opacity: 1; }
    96% { opacity: 0; }
    100% { opacity: 0; }
  }
  .aoin-word {
    display: inline-block;
    animation-duration: 1s, 1s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), linear;
    animation-fill-mode: both, both;
    animation-timeline: view(), view();
  }
  .aoin-w0 {
    animation-name: aoin-shift, aoin-f0;
    animation-range: cover 0% cover 56%, cover 0% cover 100%;
  }
  .aoin-w1 {
    animation-name: aoin-shift, aoin-f1;
    animation-range: cover 0% cover 72%, cover 0% cover 100%;
  }
  .aoin-w2 {
    animation-name: aoin-shift, aoin-f2;
    animation-range: cover 0% cover 48%, cover 0% cover 100%;
  }
  .aoin-w3 {
    animation-name: aoin-shift, aoin-f3;
    animation-range: cover 0% cover 64%, cover 0% cover 100%;
  }
  @container (max-width: 640px) {
    .aoin-line {
      width: 100% !important;
      margin-left: 0 !important;
    }
  }
  /* On phones the nav rail sits at 20px — match it so the names span the same
     width instead of being boxed in tighter than the chrome. */
  @media (max-width: 720px) {
    .aoin-clients {
      /* Much taller rows than desktop's 2.7: the mobile font is small (11px), so
         without extra lead the whole roster fits on one screen and there's no
         scroll range for the reveal to play across. This makes the section taller
         than the viewport so names settle/fade in as you scroll past them. */
      --lead: 6;
      padding: 110px 20px 40px;
    }
  }
  /* Scroll-driven timelines aren't universal (older iOS Safari). Without them the
     fade would fall back to a time-based run that ends at opacity 0 and the names
     disappear — so if view() isn't supported, just show them statically. */
  @supports not (animation-timeline: view()) {
    .aoin-word {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
  /* JS fallback (the script below adds .js-reveal only when view() timelines are
     unsupported — e.g. older iOS Safari): reveal each name with the same settle +
     fade as it scrolls into view, instead of leaving them static. */
  .aoin-clients.js-reveal .aoin-word {
    opacity: 0;
    transform: translateX(var(--dx));
    transition:
      opacity 0.7s linear,
      transform 1s cubic-bezier(0.22, 1, 0.36, 1),
      /* keep the hover falloff working on this path too */
      color var(--fall-ms, 340ms) ease var(--fall-delay, 0ms);
  }
  .aoin-clients.js-reveal .aoin-word.in {
    opacity: 1;
    transform: translateX(0);
  }
  /* ---- hover focus: the word under the cursor holds, the rest fall away ----
     The reveal above already animates `opacity` off the scroll timeline, and a
     running animation beats any CSS opacity we could set here — so the falloff
     rides on COLOUR ALPHA instead. The two then compose (a word that has not
     been revealed yet stays invisible) rather than fight. --a is written per
     word by the script below; --fall-delay staggers by distance so the dip
     travels outward from the focus rather than snapping all at once. */
  .aoin-word {
    color: rgb(217 225 234 / var(--a, 1));
    transition: color var(--fall-ms, 340ms) ease var(--fall-delay, 0ms);
  }
  .aoin-word.is-focus {
    /* Emphasis is colour only — no scale. Pure white against coolWhite is a
       small step, and that is the point: the lift comes from the surround
       dropping, not from this word shouting. */
    color: var(--aoin-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .aoin-word {
      animation: none !important;
      transform: none;
      opacity: 1;
      /* The focus falloff still applies — it is a colour change, not motion —
         but it lands immediately instead of rippling outward. */
      transition: none;
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations (e.g. older iOS
  // Safari): reveal each client name with the same settle + fade as it scrolls
  // into view. Browsers that support `animation-timeline: view()` use the CSS
  // path above and skip this; reduced-motion users keep the static names.
  (() => {
    const section = document.querySelector<HTMLElement>('.aoin-clients');
    if (!section) return;
    if (CSS.supports('animation-timeline', 'view()')) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.classList.add('js-reveal');
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    section.querySelectorAll<HTMLElement>('.aoin-word').forEach((w) => io.observe(w));
  })();
</script>

<script>
  // Hover focus for the client roster: the name under the cursor goes pure
  // white, every other name fades down with a radial falloff from it.
  //
  // Two things make this look hand-tuned rather than mechanical:
  //   - the radius is an ELLIPSE, wider than it is tall, because the rows are
  //     set on 2.7 leading. A circular falloff would reach three rows up and
  //     only two names sideways, which reads as a vertical bar, not a glow.
  //   - each name carries a stable jitter on its own radius, so the rim of the
  //     falloff is ragged. Stable (hashed from the name, not random per hover)
  //     so the same neighbour dims by the same amount every time — a re-rolled
  //     random would shimmer when you move along a row.
  //
  // Positions come from offsetLeft/offsetTop, NOT getBoundingClientRect: the
  // reveal animation translates the words, and rects would fold that transform
  // into the measurement and drift while the section scrolls.
  (() => {
    const section = document.querySelector<HTMLElement>('.aoin-clients');
    if (!section) return;
    // Touch: there is no hover, and a tap would strand the roster mid-dim.
    if (!matchMedia('(hover: hover)').matches) return;

    const TUNE = {
      floor: 0.16,   // how far a distant name falls (colour alpha)
      radiusX: 0.46, // of the section width
      radiusY: 2.35, // of one row's height
      jitter: 0.34,  // +/- on each name's own radius
      ripple: 120,   // ms of extra delay at the rim
    };

    const words = Array.from(section.querySelectorAll<HTMLElement>('.aoin-word'));
    if (words.length < 2) return;

    // Deterministic 0..1 from the name (FNV-1a).
    const hash = (s: string) => {
      let h = 2166136261;
      for (let i = 0; i < s.length; i++) {
        h ^= s.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return ((h >>> 0) % 10000) / 10000;
    };

    type Geo = { el: HTMLElement; x: number; y: number; j: number };
    let geo: Geo[] = [];
    let rowH = 0;

    const measure = () => {
      geo = words.map((el) => ({
        el,
        x: el.offsetLeft + el.offsetWidth / 2,
        y: el.offsetTop + el.offsetHeight / 2,
        j: 1 + (hash(el.textContent || '') - 0.5) * 2 * TUNE.jitter,
      }));
      // Row pitch = the smallest gap between two distinct baselines.
      const ys = Array.from(new Set(geo.map((g) => Math.round(g.y)))).sort((a, b) => a - b);
      rowH = ys.length > 1 ? Math.min(...ys.slice(1).map((y, i) => y - ys[i])) : 40;
    };

    let current: HTMLElement | null = null;

    const focus = (el: HTMLElement) => {
      if (el === current) return;
      const me = geo.find((g) => g.el === el);
      if (!me) return;
      current?.classList.remove('is-focus');
      current = el;
      el.classList.add('is-focus');

      const rx = section.clientWidth * TUNE.radiusX;
      const ry = rowH * TUNE.radiusY;
      for (const g of geo) {
        const dx = (g.x - me.x) / (rx * g.j);
        const dy = (g.y - me.y) / (ry * g.j);
        const d = Math.min(1, Math.hypot(dx, dy));
        const near = 1 - d * d * (3 - 2 * d); // smoothstep, 1 at the focus, 0 at the rim
        g.el.style.setProperty('--a', (TUNE.floor + (1 - TUNE.floor) * near).toFixed(3));
        g.el.style.setProperty('--fall-delay', Math.round(d * TUNE.ripple) + 'ms');
      }
    };

    const clear = () => {
      if (!current) return;
      current.classList.remove('is-focus');
      current = null;
      for (const g of geo) {
        g.el.style.setProperty('--a', '1');
        // Everything comes back together — a staggered recovery reads as lag.
        g.el.style.setProperty('--fall-delay', '0ms');
      }
    };

    // Focus is held while the cursor crosses the gaps between names: the rows
    // are justified, so those gaps are wide, and dropping focus in them would
    // strobe the whole section as you move along a row.
    section.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement | null)?.closest?.('.aoin-word');
      if (el instanceof HTMLElement) focus(el);
    });
    section.addEventListener('pointerleave', clear);

    measure();
    // Text metrics move when the webfont lands and on any reflow.
    document.fonts?.ready.then(measure);
    new ResizeObserver(() => {
      measure();
      if (current) {
        const held = current;
        current = null;
        focus(held);
      }
    }).observe(section);
  })();
</script>
