---

<div class="preloader" data-ref="preloader" data-screen-label="Preloader">
  <div class="stack">
    <div class="mask"><div class="label" data-ref="preLabel">LOADING</div></div>
    <div class="mask"><div class="count" data-ref="preCount">0</div></div>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(10px, 1.6vw, 22px);
  }
  .mask {
    overflow: hidden;
  }
  .label {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: clamp(12px, 1.1vw, 15px);
    line-height: 1;
    letter-spacing: 0.3em;
    /* trailing indent balances the tracking so the word stays optically centred */
    text-indent: 0.3em;
    color: var(--aoin-cool-white);
  }
  .count {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    /* generous but full-width-centred, so three digits at 100 never clip */
    font-size: clamp(120px, 22vw, 360px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--aoin-cool-white);
    font-variant-numeric: tabular-nums;
  }
</style>
