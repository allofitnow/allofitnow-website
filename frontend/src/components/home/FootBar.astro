---
import { tagline, social } from '@/data/home';
---

<div class="foot-bar" data-ref="footBar">
  <div data-fb="1"><div data-fbi="1">{tagline}</div></div>
  <div class="social">
    {
      social.map((s) => (
        <div data-fb="1">
          <div data-fbi="1">
            <a href={s.href} target="_blank" rel="noopener">
              {s.label}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .foot-bar {
    position: fixed;
    /* left/right match the nav inset (48px desktop, 20px mobile via the
       controller) so the tagline aligns to the logo — no extra padding. */
    left: 48px;
    right: 48px;
    bottom: 24px;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--aoin-cool-white);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s linear;
  }
  .social {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 36px);
  }
  .foot-bar [data-fb] {
    overflow: hidden;
  }
  .foot-bar [data-fbi] {
    transform: translateY(110%);
    transition: transform 0.6s cubic-bezier(0.05, 0.89, 0, 0.99);
    white-space: nowrap;
  }
  .foot-bar a {
    pointer-events: auto;
  }

  /* Mobile: tagline centred, socials on their own full-width row —
     Instagram to the logo edge, LinkedIn to the menu edge. */
  @media (max-width: 720px) {
    .foot-bar {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .foot-bar > [data-fb] {
      text-align: center;
    }
    /* The tagline is one long line; at the mobile size it lands a hair wider
       than the 20px-rail container and the reveal mask (overflow:hidden) clips
       the last character. Tighten the tracking so it fits on typical phones,
       and let it wrap instead of clip on anything narrower. Scoped to the
       tagline — the social labels stay nowrap. */
    .foot-bar > [data-fb] [data-fbi] {
      white-space: normal;
      letter-spacing: 0.12em;
      line-height: 1.4;
    }
    .social {
      justify-content: space-between;
      gap: 0;
    }
  }
</style>

<script>
  // On the home page the controller owns the foot bar (scroll-reactive reveal +
  // frame alignment). Interior pages (work / project) have no such controller, so
  // it reveals and frames itself there. Mirrors home.controller applyResponsive.
  (function () {
    const place = () => {
      const bar = document.querySelector<HTMLElement>('[data-ref="footBar"]');
      if (!bar || document.querySelector('[data-home]')) return; // home owns it
      const m = window.innerWidth <= 720;
      const pad = m ? 20 : 48;
      const clientW = document.documentElement.clientWidth;
      const cmax =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--content-max')) ||
        1920;
      const edge = pad + Math.max(0, (clientW - cmax) / 2); // align to the capped frame
      bar.style.left = edge + 'px';
      bar.style.right = edge + 'px';
      bar.style.fontSize = (m ? 9 : 11) + 'px';
      bar.style.bottom = (m ? 16 : 24) + 'px';
      bar.style.opacity = '1';
      bar.querySelectorAll<HTMLElement>('[data-fbi]').forEach((el) => (el.style.transform = 'none'));
    };
    place();
    window.addEventListener('resize', place);
    document.addEventListener('astro:page-load', place);
  })();
</script>
