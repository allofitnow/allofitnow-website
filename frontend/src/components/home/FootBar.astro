---
import { tagline, social } from '@/data/home';
---

<div class="foot-bar" data-ref="footBar">
  <div data-fb="1"><div data-fbi="1">{tagline}</div></div>
  <div class="social">
    {
      social.map((s) => (
        <div data-fb="1">
          <div data-fbi="1">
            <a href={s.href} target="_blank" rel="noopener">
              {s.label}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .foot-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 24px;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 48px;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--aoin-cool-white);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s linear;
  }
  .social {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 36px);
  }
  .foot-bar [data-fb] {
    overflow: hidden;
  }
  .foot-bar [data-fbi] {
    transform: translateY(110%);
    transition: transform 0.6s cubic-bezier(0.05, 0.89, 0, 0.99);
    white-space: nowrap;
  }
  .foot-bar a {
    pointer-events: auto;
  }
</style>
