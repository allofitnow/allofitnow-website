---
// Work-grid / home-marquee hover card — a cursor-following "VIEW PROJECT" plate.
// Ported look from docs/prototypes/reflow-transition.html (#hovercard): a
// cool-white highlight. The label writes on character-by-character (staggered)
// each time the card appears (see lib/hovercard.ts).
//
// The element persists across ClientRouter swaps (like the flyer + cursor) so
// lib/hovercard.ts can bind its pointer listeners once. It shows over the work
// grid tiles and the home bleed-carousel slides ([data-slug] things that fly);
// pages without either just never trigger it.
const LABEL = 'VIEW PROJECT';
---

<div id="aoin-hovercard" aria-hidden="true" transition:persist="aoin-hovercard">
  <span class="plate">
    {LABEL.split('').map((c) => <span class="ch">{c}</span>)}
  </span>
</div>

<style>
  #aoin-hovercard {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    pointer-events: none;
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    line-height: 1;
    width: max-content;
    will-change: transform;
    visibility: hidden;
  }
  #aoin-hovercard.on {
    visibility: visible;
  }

  /* the cool-white highlight plate; pre keeps the space between the two words */
  .plate {
    display: inline-block;
    white-space: pre;
    background: var(--aoin-cool-white);
    color: var(--aoin-black);
    padding: 6px 10px 5px;
    overflow: hidden; /* safety while the letters rise into place */
  }
  .ch {
    display: inline-block;
  }
</style>
